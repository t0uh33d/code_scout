package view

import (
	"fmt"

	"github.com/google/uuid"
	"github.com/t0uh33d/code_scout/internal/domain"
)

// The overview follows the prototype's s-overview: four stat tiles, then the
// 24-hour activity chart. Its "Recent errors" and "Live devices" panels are
// deliberately absent — grouped errors need the fingerprint from the sessions
// slice, and live devices needs the WebSocket. Neither is faked here.

type OverviewData struct {
	User      *domain.User
	Project   *domain.Project
	ProjectID uuid.UUID
	Stats     *domain.ProjectOverview
}

func (d OverviewData) shell() ProjectShellData {
	return ProjectShellData{User: d.User, ProjectID: d.ProjectID, Project: d.Project, Active: "overview"}
}

templ OverviewPage(d OverviewData) {
	@ProjectShell(d.shell()) {
		<h1 class="text-xl font-bold text-white">Overview</h1>
		<p class="mt-1 text-sm text-cs-muted">The last 24 hours.</p>
		if d.Stats == nil || d.Stats.Logs == 0 {
			@overviewEmpty(d.ProjectID)
		} else {
			<div class="mt-5 grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
				@statTile("Total logs", humanCount(d.Stats.Logs), deltaLabel(d.Stats.LogDelta(), "vs yesterday"),
					deltaTone(d.Stats.LogDelta(), false), fmt.Sprintf("/project/%s/logs", d.ProjectID))
				@statTile("Errors", humanCount(d.Stats.Errors), deltaLabel(d.Stats.ErrorDelta(), "vs yesterday"),
					deltaTone(d.Stats.ErrorDelta(), true), fmt.Sprintf("/project/%s/logs?q=level:error", d.ProjectID))
				@statTile("Network calls", humanCount(d.Stats.Network), failedLabel(d.Stats.Failed), "muted", "")
				@statTile("Sessions", humanCount(d.Stats.Sessions), "in the last 24 hours", "muted", "")
			</div>
			@activityChart(d.Stats)
		}
	}
}

// statTile links only where the destination exists. The prototype links all
// four, but Network and Sessions have no screen yet and a tile that goes
// nowhere is worse than a tile that does not pretend to.
templ statTile(label string, value string, detail string, tone string, href string) {
	if href != "" {
		<a
			href={ templ.SafeURL(href) }
			class="flex flex-col gap-1 rounded-xl border border-cs-border p-5 no-underline transition-colors hover:border-cs-primary/40"
		>
			@statTileBody(label, value, detail, tone)
		</a>
	} else {
		<div class="flex flex-col gap-1 rounded-xl border border-cs-border p-5">
			@statTileBody(label, value, detail, tone)
		</div>
	}
}

templ statTileBody(label string, value string, detail string, tone string) {
	<span class="text-xs font-medium uppercase tracking-wider text-cs-muted">{ label }</span>
	<span
		class={ "text-2xl font-bold tabular-nums",
			templ.KV("text-cs-danger", tone == "bad"),
			templ.KV("text-white", tone != "bad") }
	>{ value }</span>
	<span
		class={ "text-xs",
			templ.KV("text-cs-danger", tone == "bad"),
			templ.KV("text-cs-success", tone == "good"),
			templ.KV("text-cs-muted", tone == "muted") }
	>{ detail }</span>
}

// activityChart is 24 columns, one per hour. Each column is stacked: the errors
// in that hour sit at the bottom in red, the rest above in blue. Colouring a
// whole bar red whenever it held any error made every hour red on a busy
// project, which said nothing — the stack shows the share instead, and needs no
// invented threshold to decide what counts as a bad hour.
templ activityChart(s *domain.ProjectOverview) {
	{{ peak := chartPeak(s) }}
	<div class="mt-4 rounded-xl border border-cs-border p-6">
		<h2 class="text-base font-semibold text-white">Activity · last 24 hours</h2>
		<div class="mt-5 flex h-[88px] items-end gap-[3px]">
			for _, b := range s.Buckets {
				<div
					title={ bucketTitle(b) }
					style={ fmt.Sprintf("height:%d%%", barHeight(b.TotalCount, peak)) }
					class="flex min-h-[2px] flex-1 flex-col justify-end overflow-hidden rounded-sm bg-cs-primary/50"
				>
					if b.ErrorCount > 0 {
						<span
							style={ fmt.Sprintf("height:%d%%", errorShare(b)) }
							class="w-full bg-cs-danger/80"
						></span>
					}
				</div>
			}
		</div>
		<div class="mt-2 flex items-center justify-between text-[11px] text-cs-muted">
			<span>{ fmtTime(s.WindowStartHour, "15:04") }</span>
			if s.PeakErrorCount > 0 {
				<span class="text-cs-danger">
					{ fmt.Sprintf("worst hour for errors · %s", fmtTime(s.PeakErrorHour, "15:04")) }
				</span>
			}
			<span>now</span>
		</div>
	</div>
}

// errorShare is how much of an hour's column is drawn red. Floored at 6% so a
// single error in a busy hour is still a visible sliver rather than nothing.
func errorShare(b domain.LogStatsBucket) int {
	if b.TotalCount == 0 {
		return 0
	}
	share := int(b.ErrorCount * 100 / b.TotalCount)
	if share < 6 {
		return 6
	}
	if share > 100 {
		return 100
	}
	return share
}

// overviewEmpty is the first-run state: a project exists but nothing has ever
// reported to it, so the only useful thing to show is where the snippet lives.
templ overviewEmpty(projectID uuid.UUID) {
	<div class="mt-5 flex flex-col items-center gap-6 rounded-xl border border-cs-border py-16">
		<img src="/static/images/empty_projects.png" class="h-[180px] w-auto" alt="Pim has not found any logs"/>
		<div class="flex flex-col gap-2 text-center">
			<p class="text-lg font-bold tracking-[0.18px] text-white">Nothing has reported yet</p>
			<p class="text-sm tracking-[0.14px] text-cs-muted">Add the snippet to your Flutter app and the first logs land here.</p>
		</div>
		<a
			href={ templ.SafeURL(fmt.Sprintf("/project/%s/settings?tab=sdk", projectID)) }
			class="rounded-lg bg-cs-primary px-5 py-2 font-display text-sm font-semibold text-cs-btn-text no-underline transition-colors hover:bg-blue-600"
		>Show me the snippet</a>
	</div>
}

// chartPeak is the tallest bar, so the chart scales to what actually happened
// rather than to a fixed ceiling. Never zero, or every bar would divide by it.
func chartPeak(s *domain.ProjectOverview) int64 {
	var peak int64 = 1
	for _, b := range s.Buckets {
		if b.TotalCount > peak {
			peak = b.TotalCount
		}
	}
	return peak
}

// barHeight keeps a visible stub for a non-empty hour, so "a little" never
// looks the same as "nothing".
func barHeight(count, peak int64) int {
	if count == 0 {
		return 2
	}
	h := int(count * 100 / peak)
	if h < 4 {
		return 4
	}
	return h
}

// Local, because buckets are computed in UTC but read by a person. Same
// convention as the log viewer, which formats timestamps server-side too.
func bucketTitle(b domain.LogStatsBucket) string {
	at := fmtTime(b.Hour, "15:04")
	if b.ErrorCount > 0 {
		return fmt.Sprintf("%s — %s logs, %s errors", at, commaGroup(b.TotalCount), commaGroup(b.ErrorCount))
	}
	return fmt.Sprintf("%s — %s logs", at, commaGroup(b.TotalCount))
}

// humanCount keeps large numbers readable in a tile, the way the prototype
// writes them.
func humanCount(n int64) string {
	switch {
	case n >= 1_000_000:
		return fmt.Sprintf("%.1fM", float64(n)/1_000_000)
	case n >= 10_000:
		return fmt.Sprintf("%.1fk", float64(n)/1_000)
	default:
		return commaGroup(n)
	}
}

func commaGroup(n int64) string {
	s := fmt.Sprintf("%d", n)
	if len(s) <= 3 {
		return s
	}
	var out []byte
	for i, c := range []byte(s) {
		if i > 0 && (len(s)-i)%3 == 0 {
			out = append(out, ',')
		}
		out = append(out, c)
	}
	return string(out)
}

func deltaLabel(delta int64, suffix string) string {
	switch {
	case delta > 0:
		return fmt.Sprintf("↑ %s %s", commaGroup(delta), suffix)
	case delta < 0:
		return fmt.Sprintf("↓ %s %s", commaGroup(-delta), suffix)
	default:
		return "no change " + suffix
	}
}

// deltaTone decides the colour. More errors is bad; more logs is just more.
func deltaTone(delta int64, moreIsWorse bool) string {
	if !moreIsWorse || delta <= 0 {
		return "muted"
	}
	return "bad"
}

func failedLabel(failed int64) string {
	if failed == 0 {
		return "none failed"
	}
	return fmt.Sprintf("%s failed", commaGroup(failed))
}
