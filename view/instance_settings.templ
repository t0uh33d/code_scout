package view

import (
	"time"

	"github.com/t0uh33d/code_scout/internal/domain"
	"github.com/t0uh33d/code_scout/pkg/utils"
)

// Instance settings follow the prototype's s-instance: runtime configuration
// that lives in the database and is editable here. Boot configuration — the
// database host, credentials, port, TLS — deliberately stays in file/env and is
// not reachable from this screen.
//
// The prototype also draws Retention and Limits cards. Those are not here yet
// because nothing enforces them: an input that silently does nothing is worse
// than no input. They land with the volume-controls slice.

type InstanceSettingsData struct {
	User     *domain.User
	Settings domain.InstanceSettings
	Errors   []utils.FieldError
	Saved    bool
	// Tab is the pane to show: general or members.
	Tab string
	// Members fills the Members pane. Built by the same code the standalone
	// members screen used, so the two cannot drift.
	Members MembersData
}

// Tabs a member cannot use are not rendered. Everyone signed in may see who
// else exists, so Members is always there; General changes how every project
// renders and belongs to the super admin.
func (d InstanceSettingsData) tabs() []settingsTab {
	tabs := []settingsTab{}
	if d.User != nil && d.User.Role == domain.RoleSuperAdmin {
		tabs = append(tabs, settingsTab{"general", "General"})
	}
	return append(tabs, settingsTab{"members", "Members"})
}

// activeTab falls back to the first tab available to this account, so a
// hand-typed ?tab=general cannot render a pane an admin may not have.
func (d InstanceSettingsData) activeTab() string {
	tabs := d.tabs()
	for _, t := range tabs {
		if t.Key == d.Tab {
			return t.Key
		}
	}
	return tabs[0].Key
}

templ InstanceSettingsPage(d InstanceSettingsData) {
	@BaseLayout("Code Scout — Settings") {
		<div class="min-h-screen bg-chinese-black">
			@TopNav(d.User)
			<main class="mx-auto max-w-[1440px] px-[60px] pb-20 pt-10">
				<h1 class="text-2xl font-bold tracking-[0.24px] text-cs-text">Settings</h1>
				<p class="mt-1 text-sm text-cs-muted">
					Settings for the whole instance. Database and network configuration stays in your env file.
				</p>
				@InstanceSettingsBody(d)
			</main>
			<!-- Outside the swapped body, so switching tabs cannot remove the
			     sheet the Members pane opens into. -->
			@MemberSheet()
		</div>
	}
}

// InstanceSettingsBody is the tab bar plus the active pane, swapped as one
// because the underline has to move with the pane. Same pattern as project
// settings: the tab links are real addresses, and the handler answers with just
// this fragment for htmx and the whole page for a browser.
templ InstanceSettingsBody(d InstanceSettingsData) {
	{{ active := d.activeTab() }}
	<div id="instance-settings-body" class="mt-5">
		<div class="flex flex-wrap items-center gap-6 border-b border-cs-border">
			for _, t := range d.tabs() {
				<button
					type="button"
					hx-get={ "/settings?tab=" + t.Key }
					hx-target="#instance-settings-body"
					hx-swap="outerHTML"
					hx-push-url="true"
					if t.Key == active {
						aria-current="page"
					}
					class={ "-mb-px border-b-2 pb-3 text-sm transition-colors",
						templ.KV("border-cs-primary font-semibold text-cs-primary", t.Key == active),
						templ.KV("border-transparent text-cs-muted hover:text-white", t.Key != active) }
				>{ t.Label }</button>
			}
		</div>
		<div class="pt-5">
			switch active {
				case "members":
					@MembersPane(d.Members)
				default:
					<div class="grid grid-cols-1 items-start gap-4 lg:grid-cols-2">
						@TimezoneForm(d)
					</div>
			}
		</div>
	</div>
}

// TimezoneForm replaces itself on save, so the same template renders the first
// paint, the saved state and any error.
templ TimezoneForm(d InstanceSettingsData) {
	{{ tzErr := fieldErrorFor(d.Errors, "timezone") }}
	<form
		id="timezone-form"
		hx-post="/settings/timezone"
		hx-target="#timezone-form"
		hx-swap="outerHTML"
		hx-disabled-elt="find button[type='submit']"
		class="rounded-xl border border-cs-border bg-cs-card p-6"
	>
		<h2 class="text-base font-semibold text-white">Display</h2>
		<p class="mt-2 text-sm text-cs-muted">
			Every timestamp in the dashboard is shown in this zone. Logs are stored in UTC either way, so changing it never moves your data.
		</p>
		<div class="mt-5 flex flex-col gap-[6px]">
			<label for="timezone" class="text-sm font-medium text-cs-muted">Timezone</label>
			<select
				id="timezone"
				name="timezone"
				class={ "w-full rounded-lg border bg-chinese-black px-4 py-3 text-sm text-white transition-colors focus:outline-none",
					templ.KV("border-cs-danger", tzErr != ""),
					templ.KV("border-cs-border focus:border-cs-primary", tzErr == "") }
			>
				for _, tz := range commonTimezones() {
					<option value={ tz } selected?={ tz == d.Settings.Timezone }>{ timezoneLabel(tz) }</option>
				}
			</select>
			@fieldError(tzErr)
			<p class="mt-1 text-xs text-cs-muted">
				Right now that reads { fmtTime(time.Now(), "Mon 2 Jan, 15:04") }.
			</p>
		</div>
		<div class="mt-5 flex items-center justify-end gap-3">
			if d.Saved {
				<span class="text-xs text-cs-success">Saved</span>
			}
			<button
				type="submit"
				class="rounded-lg bg-cs-primary px-5 py-2 font-display text-sm font-semibold text-cs-btn-text transition-colors hover:bg-blue-600"
			>Save changes</button>
		</div>
	</form>
}

// commonTimezones is a short list rather than the host's full tzdata, which
// runs to several hundred entries and is unusable in a select. Anything missing
// can be added here; the server accepts any zone it can load.
func commonTimezones() []string {
	return []string{
		"UTC",
		"America/Los_Angeles",
		"America/Denver",
		"America/Chicago",
		"America/New_York",
		"America/Sao_Paulo",
		"Europe/London",
		"Europe/Berlin",
		"Europe/Moscow",
		"Africa/Lagos",
		"Africa/Johannesburg",
		"Asia/Dubai",
		"Asia/Karachi",
		"Asia/Kolkata",
		"Asia/Dhaka",
		"Asia/Bangkok",
		"Asia/Singapore",
		"Asia/Shanghai",
		"Asia/Tokyo",
		"Australia/Sydney",
		"Pacific/Auckland",
	}
}

// timezoneLabel shows the current offset beside the name, because "Asia/Kolkata"
// means less at a glance than "+05:30" does.
func timezoneLabel(name string) string {
	loc, err := time.LoadLocation(name)
	if err != nil {
		return name
	}
	return name + " (" + time.Now().In(loc).Format("-07:00") + ")"
}
