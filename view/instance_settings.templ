package view

import (
	"strconv"
	"time"

	"github.com/getcodescout/code_scout/internal/domain"
	"github.com/getcodescout/code_scout/pkg/utils"
)

// Instance settings follow the prototype's s-instance: runtime configuration
// that lives in the database and is editable here. Boot configuration — the
// database host, credentials, port, TLS — deliberately stays in file/env and is
// not reachable from this screen.

type InstanceSettingsData struct {
	User     *domain.User
	Settings domain.InstanceSettings
	Errors   []utils.FieldError
	Saved    bool
	// Raw carries back exactly what was posted when a value is refused, so a
	// rejected number is corrected rather than retyped. A select can only ever
	// hold a value it offers, so the timezone does not need this; a free-text
	// number does. Empty means "render the stored value".
	Raw map[string]string
	// Tab is the pane to show: general or members.
	Tab string
	// Members fills the Members pane. Built by the same code the standalone
	// members screen used, so the two cannot drift.
	Members MembersData
}

// Tabs a member cannot use are not rendered. Everyone signed in may see who
// else exists, so Members is always there; General changes how every project
// renders and belongs to the super admin.
func (d InstanceSettingsData) tabs() []settingsTab {
	tabs := []settingsTab{}
	if d.User != nil && d.User.Role == domain.RoleSuperAdmin {
		tabs = append(tabs, settingsTab{"general", "General"})
	}
	return append(tabs, settingsTab{"members", "Members"})
}

// activeTab falls back to the first tab available to this account, so a
// hand-typed ?tab=general cannot render a pane an admin may not have.
func (d InstanceSettingsData) activeTab() string {
	tabs := d.tabs()
	for _, t := range tabs {
		if t.Key == d.Tab {
			return t.Key
		}
	}
	return tabs[0].Key
}

templ InstanceSettingsPage(d InstanceSettingsData) {
	@BaseLayout("Code Scout — Settings") {
		<div class="min-h-screen bg-chinese-black">
			@TopNav(d.User)
			<main class="mx-auto max-w-[1440px] px-[60px] pb-20 pt-10">
				<h1 class="text-2xl font-bold tracking-[0.24px] text-cs-text">Settings</h1>
				<p class="mt-1 text-sm text-cs-muted">
					Settings for the whole instance. Database and network configuration stays in your env file.
				</p>
				@InstanceSettingsBody(d)
			</main>
			<!-- Outside the swapped body, so switching tabs cannot remove the
			     sheet the Members pane opens into. -->
			@MemberSheet()
		</div>
	}
}

// InstanceSettingsBody is the tab bar plus the active pane, swapped as one
// because the underline has to move with the pane. Same pattern as project
// settings: the tab links are real addresses, and the handler answers with just
// this fragment for htmx and the whole page for a browser.
templ InstanceSettingsBody(d InstanceSettingsData) {
	{{ active := d.activeTab() }}
	<div id="instance-settings-body" class="mt-5">
		<div class="flex flex-wrap items-center gap-6 border-b border-cs-border">
			for _, t := range d.tabs() {
				<button
					type="button"
					hx-get={ "/settings?tab=" + t.Key }
					hx-target="#instance-settings-body"
					hx-swap="outerHTML"
					hx-push-url="true"
					if t.Key == active {
						aria-current="page"
					}
					class={ "-mb-px border-b-2 pb-3 text-sm transition-colors",
						templ.KV("border-cs-primary font-semibold text-cs-primary", t.Key == active),
						templ.KV("border-transparent text-cs-muted hover:text-white", t.Key != active) }
				>{ t.Label }</button>
			}
		</div>
		<div class="pt-5">
			switch active {
				case "members":
					@MembersPane(d.Members)
				default:
					<div class="grid grid-cols-1 items-start gap-4 lg:grid-cols-2">
						@DisplayForm(d)
						<div class="flex flex-col gap-4">
							@RetentionForm(d)
							@LimitsForm(d)
						</div>
					</div>
			}
		</div>
	</div>
}

// DisplayForm replaces itself on save, so the same template renders the first
// paint, the saved state and any error.
//
// Zone and clock live on one card and save together because they are the same
// decision to a reader — how a timestamp should look. They are two settings
// behind it, so one being rejected leaves the other alone.
templ DisplayForm(d InstanceSettingsData) {
	{{ tzErr := fieldErrorFor(d.Errors, "timezone") }}
	{{ fmtErr := fieldErrorFor(d.Errors, "time_format") }}
	<form
		id="timezone-form"
		hx-post="/settings/display"
		hx-target="#timezone-form"
		hx-swap="outerHTML"
		hx-disabled-elt="find button[type='submit']"
		class="rounded-xl border border-cs-border bg-cs-card p-6"
	>
		<h2 class="text-base font-semibold text-white">Display</h2>
		<p class="mt-2 text-sm text-cs-muted">
			Every timestamp in the dashboard is shown in this zone. Logs are stored in UTC either way, so changing it never moves your data.
		</p>
		<div class="mt-5 flex flex-col gap-[6px]">
			<label for="timezone" class="text-sm font-medium text-cs-muted">Timezone</label>
			<select
				id="timezone"
				name="timezone"
				class={ "w-full rounded-lg border bg-chinese-black px-4 py-3 text-sm text-white transition-colors focus:outline-none",
					templ.KV("border-cs-danger", tzErr != ""),
					templ.KV("border-cs-border focus:border-cs-primary", tzErr == "") }
			>
				for _, tz := range commonTimezones() {
					<option value={ tz } selected?={ tz == d.Settings.Timezone }>{ timezoneLabel(tz) }</option>
				}
			</select>
			@fieldError(tzErr)
		</div>
		<div class="mt-5 flex flex-col gap-[6px]">
			<span class="text-sm font-medium text-cs-muted">Clock</span>
			<!-- Radios, not a select: two options that are both worth reading at
			     a glance, and the choice is visible without opening anything. -->
			<div class="flex flex-wrap gap-2">
				@clockOption(domain.TimeFormat24, "24-hour", "15:04", d.Settings.TimeFormat)
				@clockOption(domain.TimeFormat12, "12-hour", "3:04 PM", d.Settings.TimeFormat)
			</div>
			@fieldError(fmtErr)
			<p class="mt-1 text-xs text-cs-muted">
				Right now that reads { fmtTime(time.Now(), DateTimeWithDay) }.
			</p>
		</div>
		<div class="mt-5 flex items-center justify-end gap-3">
			if d.Saved {
				<span class="text-xs text-cs-success">Saved</span>
			}
			<button
				type="submit"
				class="rounded-lg bg-cs-primary px-5 py-2 font-display text-sm font-semibold text-cs-btn-text transition-colors hover:bg-blue-600"
			>Save changes</button>
		</div>
	</form>
}

// clockOption is one of the two radios. The whole label is the control, so the
// example is as clickable as the name — and the example is what people actually
// aim at, because it is the thing they are choosing between.
templ clockOption(value string, name string, example string, selected string) {
	<label
		class={ "flex cursor-pointer items-baseline gap-2 rounded-lg border px-4 py-3 text-sm transition-colors",
			templ.KV("border-cs-primary text-white", value == selected),
			templ.KV("border-cs-border text-cs-muted hover:border-cs-primary/50", value != selected) }
	>
		<input
			type="radio"
			name="time_format"
			value={ value }
			checked?={ value == selected }
			class="accent-cs-primary"
		/>
		{ name }
		<span class="font-mono text-xs text-cs-placeholder">{ example }</span>
	</label>
}

// commonTimezones is a short list rather than the host's full tzdata, which
// runs to several hundred entries and is unusable in a select. Anything missing
// can be added here; the server accepts any zone it can load.
func commonTimezones() []string {
	return []string{
		"UTC",
		"America/Los_Angeles",
		"America/Denver",
		"America/Chicago",
		"America/New_York",
		"America/Sao_Paulo",
		"Europe/London",
		"Europe/Berlin",
		"Europe/Moscow",
		"Africa/Lagos",
		"Africa/Johannesburg",
		"Asia/Dubai",
		"Asia/Karachi",
		"Asia/Kolkata",
		"Asia/Dhaka",
		"Asia/Bangkok",
		"Asia/Singapore",
		"Asia/Shanghai",
		"Asia/Tokyo",
		"Australia/Sydney",
		"Pacific/Auckland",
	}
}

// timezoneLabel shows the current offset beside the name, because "Asia/Kolkata"
// means less at a glance than "+05:30" does.
func timezoneLabel(name string) string {
	loc, err := time.LoadLocation(name)
	if err != nil {
		return name
	}
	return name + " (" + time.Now().In(loc).Format("-07:00") + ")"
}

// RetentionForm and LimitsForm are the prototype's two remaining cards. Both
// follow TimezoneForm exactly — self-targeting, one endpoint each, re-rendered
// by their own handler — so a save on one cannot light up "Saved" on another.
templ RetentionForm(d InstanceSettingsData) {
	{{ keepErr := fieldErrorFor(d.Errors, "retention_days") }}
	{{ purgeErr := fieldErrorFor(d.Errors, "purge_after_days") }}
	<form
		id="retention-form"
		hx-post="/settings/retention"
		hx-target="#retention-form"
		hx-swap="outerHTML"
		hx-disabled-elt="find button[type='submit']"
		class="rounded-xl border border-cs-border bg-cs-card p-6"
	>
		<h2 class="text-base font-semibold text-white">Retention</h2>
		<p class="mt-2 text-sm text-cs-muted">
			A nightly job hides logs past the first window, then deletes them for good after the second. The gap is what makes a change you regret recoverable.
		</p>
		<div class="mt-5 flex flex-col gap-5">
			@numberField(numberFieldOpts{
				ID: "retention-days", Name: "retention_days", Label: "Keep logs for",
				Value: d.raw("retention_days", itoa(d.Settings.RetentionDays)),
				Min: domain.MinRetentionDays, Max: domain.MaxRetentionDays,
				Hint: "days", Err: keepErr,
			})
			@numberField(numberFieldOpts{
				ID: "purge-days", Name: "purge_after_days", Label: "Purge deleted after",
				Value: d.raw("purge_after_days", itoa(d.Settings.PurgeAfterDays)),
				Min: domain.MinPurgeAfterDays, Max: domain.MaxPurgeAfterDays,
				Hint: "days after a log is hidden, it is gone", Err: purgeErr,
			})
		</div>
		@saveRow(d.Saved)
	</form>
}

templ LimitsForm(d InstanceSettingsData) {
	{{ uploadErr := fieldErrorFor(d.Errors, "max_upload_mb") }}
	{{ capErr := fieldErrorFor(d.Errors, "daily_log_cap") }}
	<form
		id="limits-form"
		hx-post="/settings/limits"
		hx-target="#limits-form"
		hx-swap="outerHTML"
		hx-disabled-elt="find button[type='submit']"
		class="rounded-xl border border-cs-border bg-cs-card p-6"
	>
		<h2 class="text-base font-semibold text-white">Limits</h2>
		<p class="mt-2 text-sm text-cs-muted">
			What a single upload from an SDK may weigh. Anything larger is refused outright rather than partly stored.
		</p>
		<div class="mt-5 flex flex-col gap-5">
			@numberField(numberFieldOpts{
				ID: "max-upload-mb", Name: "max_upload_mb", Label: "Max upload size",
				Value: d.raw("max_upload_mb", itoa(d.Settings.MaxUploadMB())),
				Min: domain.MinMaxUploadMB, Max: domain.MaxMaxUploadMB,
				Hint: "MB, compressed", Err: uploadErr,
			})
			@numberField(numberFieldOpts{
				ID: "daily-log-cap", Name: "daily_log_cap", Label: "Per-project daily log cap",
				Value: d.raw("daily_log_cap", itoa64(d.Settings.DailyLogCap)),
				Min: 0, Max: 0,
				Hint: "logs per project per UTC day, 0 for no cap", Err: capErr,
			})
		</div>
		@saveRow(d.Saved)
	</form>
}

// numberFieldOpts keeps the call sites readable; a positional templ with seven
// string arguments is unreadable at the third one.
type numberFieldOpts struct {
	ID    string
	Name  string
	Label string
	Value string
	Min   int
	Max   int
	Hint  string
	Err   string
}

// The first type="number" in the codebase. min/max let the browser catch the
// easy mistakes, but the server validates independently — the e2e posts by
// hand and a browser control is not a boundary.
templ numberField(o numberFieldOpts) {
	<div class="flex flex-col gap-[6px]">
		<label for={ o.ID } class="text-sm font-medium text-cs-muted">{ o.Label }</label>
		<input
			type="number"
			id={ o.ID }
			name={ o.Name }
			value={ o.Value }
			min={ itoa(o.Min) }
			if o.Max > 0 {
				max={ itoa(o.Max) }
			}
			step="1"
			inputmode="numeric"
			aria-describedby={ o.ID + "-error" }
			class={ "w-full rounded-lg border bg-chinese-black px-4 py-3 text-sm text-white transition-colors focus:outline-none",
				templ.KV("border-cs-danger focus:border-cs-danger", o.Err != ""),
				templ.KV("border-cs-border focus:border-cs-primary", o.Err == "") }
		/>
		<span id={ o.ID + "-error" }>
			@fieldError(o.Err)
		</span>
		<p class="mt-1 text-xs text-cs-muted">{ o.Hint }</p>
	</div>
}

templ saveRow(saved bool) {
	<div class="mt-5 flex items-center justify-end gap-3">
		if saved {
			<span class="text-xs text-cs-success">Saved</span>
		}
		<button
			type="submit"
			class="rounded-lg bg-cs-primary px-5 py-2 font-display text-sm font-semibold text-cs-btn-text transition-colors hover:bg-blue-600"
		>Save changes</button>
	</div>
}

// raw prefers what the user just typed over what is stored, so a refused value
// stays on screen to be corrected.
func (d InstanceSettingsData) raw(field, fallback string) string {
	if v, ok := d.Raw[field]; ok {
		return v
	}
	return fallback
}

func itoa(n int) string { return strconv.Itoa(n) }

func itoa64(n int64) string { return strconv.FormatInt(n, 10) }
