package view

import (
	"fmt"

	"github.com/google/uuid"
	"github.com/t0uh33d/code_scout/internal/domain"
	"github.com/t0uh33d/code_scout/view/static"
)

// ProjectShellData is the chrome every project-scoped page shares.
type ProjectShellData struct {
	User      *domain.User
	ProjectID uuid.UUID
	// Project may be nil if it could not be loaded; the sidebar then falls back
	// to showing the id, rather than the page failing to render.
	Project *domain.Project
	// Active marks the sidebar item: "logs" or "settings". Session timeline and
	// network detail are children of the log viewer, so they pass "logs".
	Active string
}

func (d ProjectShellData) projectName() string {
	if d.Project != nil && d.Project.Name != "" {
		return d.Project.Name
	}
	return "Project"
}

func (d ProjectShellData) pageTitle() string {
	return fmt.Sprintf("Code Scout — %s", d.projectName())
}

// ProjectShell wraps every screen belonging to one project — Figma 3370:3775.
//
// Project screens drop the top nav for two cards inset 16px from the page edge:
// a fixed-width sidebar and the content beside it, both full height. The
// account menu moves to the foot of the sidebar, since there is no longer a nav
// bar to hold it.
templ ProjectShell(d ProjectShellData) {
	@BaseLayout(d.pageTitle()) {
		<div class="min-h-screen bg-chinese-black p-4">
			<!-- Fixed height only from md up: on a desktop the two cards scroll
			     independently, on a phone they stack and grow with the page. -->
			<div class="flex flex-col gap-4 md:h-[calc(100vh-2rem)] md:flex-row">
				@projectSidebar(d)
				<main class="min-w-0 flex-1 overflow-y-auto rounded-xl bg-cs-card px-6 py-4">
					{ children... }
				</main>
			</div>
		</div>
	}
}

templ projectSidebar(d ProjectShellData) {
	<aside class="flex w-full shrink-0 flex-col justify-between gap-8 rounded-xl bg-cs-card p-4 md:w-[218px]">
		<!-- The scroll lives here, not on the aside: the parent imposes a height,
		     so on a short viewport or at 200% zoom this group has to give. Putting
		     overflow on the aside instead would clip the account menu, because a
		     non-visible overflow on one axis forces the other to clip too. -->
		<div data-sidebar-scroll class="flex min-h-0 flex-col gap-8 overflow-y-auto">
			<!-- The frame gives project screens no way back to the list. The logo
			     is where every other app puts that, and it costs no space the
			     sidebar was using for something else. -->
			<a href="/" class="inline-flex shrink-0 items-center" aria-label="All projects">
				<img src={ static.LOGIN_HEADER_IMAGE } class="h-9 w-auto" alt="Code Scout"/>
			</a>
			<div class="flex flex-col gap-4">
				<div class="flex flex-col gap-1">
					@projectShellName(d.projectName(), false)
					<!-- A UUID never fits 218px, so the full value lives in the
					     title. Settings is where you go to copy it. -->
					<p title={ d.ProjectID.String() } class="truncate font-mono text-xs tracking-[0.12px] text-cs-muted">{ d.ProjectID.String() }</p>
				</div>
				<!-- The prototype's nav is Overview, Logs, Network, Sessions,
				     Errors, Devices, Live, Settings. Items appear here as their
				     screens land; the order is the prototype's so it grows into
				     the right shape rather than being reshuffled later. -->
				<nav class="flex flex-row gap-1.5 md:flex-col">
					@projectNavItem(fmt.Sprintf("/project/%s/overview", d.ProjectID), "Overview", d.Active == "overview") {
						@iconOverview()
					}
					@projectNavItem(fmt.Sprintf("/project/%s/logs", d.ProjectID), "Logs", d.Active == "logs") {
						@iconLogs()
					}
					@projectNavItem(fmt.Sprintf("/project/%s/sessions", d.ProjectID), "Sessions", d.Active == "sessions") {
						@iconSessions()
					}
					@projectNavItem(fmt.Sprintf("/project/%s/errors", d.ProjectID), "Errors", d.Active == "errors") {
						@iconErrors()
					}
					@projectNavItem(fmt.Sprintf("/project/%s/devices", d.ProjectID), "Devices", d.Active == "devices") {
						@iconDevices()
					}
					@projectNavItem(fmt.Sprintf("/project/%s/settings", d.ProjectID), "Settings", d.Active == "settings") {
						@iconSettings()
					}
				</nav>
			</div>
		</div>
		@sidebarAccountMenu(d.User)
	</aside>
}

// projectShellName is the sidebar heading, rendered either in place or as the
// out-of-band fragment a rename swaps in. Both go through here so the two can
// never disagree about how the heading looks.
templ projectShellName(name string, oob bool) {
	<h2
		id="project-shell-name"
		if oob {
			hx-swap-oob="true"
		}
		class="truncate text-lg font-bold tracking-[0.18px] text-white"
	>{ name }</h2>
}

// projectNavItem is a card rather than a plain link. An inactive card is the
// same colour as the sidebar behind it, so it only reads as a card once the
// pointer is over it or it becomes active.
templ projectNavItem(href string, label string, active bool) {
	<a
		href={ templ.SafeURL(href) }
		if active {
			aria-current="page"
		}
		class={ "flex items-center gap-2 rounded p-2 text-xs font-medium leading-[18px] no-underline shadow-[0px_1px_1.5px_rgba(19,19,24,0.1),0px_1px_1px_rgba(19,19,24,0.06)] transition-colors",
			templ.KV("bg-cs-primary text-white", active),
			templ.KV("bg-cs-card text-cs-muted hover:bg-cs-border hover:text-white", !active) }
	>
		{ children... }
		{ label }
	</a>
}

// Both glyphs are Charlin's, exported from the frame and re-filled with
// currentColor so the active and inactive states come from the parent. Each
// keeps its designed size, centred in an 18px box.
templ iconLogs() {
	<span class="flex size-[18px] shrink-0 items-center justify-center">
		<svg width="14.625" height="16.125" viewBox="0 0 14.625 16.125" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M6.52019 2.4121e-07H8.10481C9.48313 -1.16499e-05 10.5749 -2.11224e-05 11.4293 0.114851C12.3086 0.233072 13.0203 0.48216 13.5816 1.04343C14.1428 1.60471 14.3919 2.31642 14.5101 3.19573C14.625 4.05014 14.625 5.14187 14.625 6.52019V9.60481C14.625 10.9831 14.625 12.0749 14.5101 12.9293C14.3919 13.8086 14.1428 14.5203 13.5816 15.0816C13.0203 15.6428 12.3086 15.8919 11.4293 16.0101C10.5749 16.125 9.48313 16.125 8.10481 16.125H6.52019C5.14187 16.125 4.05014 16.125 3.19573 16.0101C2.31642 15.8919 1.60471 15.6428 1.04343 15.0816C0.48216 14.5203 0.233072 13.8086 0.114851 12.9293C-2.11224e-05 12.0749 -1.16499e-05 10.9831 2.4121e-07 9.60481V6.52019C-1.16499e-05 5.14187 -2.11224e-05 4.05014 0.114851 3.19573C0.233072 2.31642 0.48216 1.60471 1.04343 1.04343C1.60471 0.48216 2.31642 0.233072 3.19573 0.114851C4.05014 -2.11224e-05 5.14187 -1.16499e-05 6.52019 2.4121e-07ZM3.34564 1.22982C2.59107 1.33127 2.15634 1.52152 1.83893 1.83893C1.52152 2.15634 1.33127 2.59107 1.22982 3.34564C1.1262 4.11638 1.125 5.13238 1.125 6.5625V9.5625C1.125 10.9926 1.1262 12.0086 1.22982 12.7794C1.33127 13.5339 1.52152 13.9687 1.83893 14.2861C2.15634 14.6035 2.59107 14.7937 3.34564 14.8952C4.11639 14.9988 5.13238 15 6.5625 15H8.0625C9.49262 15 10.5086 14.9988 11.2794 14.8952C12.0339 14.7937 12.4687 14.6035 12.7861 14.2861C13.1035 13.9687 13.2937 13.5339 13.3952 12.7794C13.4988 12.0086 13.5 10.9926 13.5 9.5625V6.5625C13.5 5.13239 13.4988 4.11639 13.3952 3.34564C13.2937 2.59107 13.1035 2.15634 12.7861 1.83893C12.4687 1.52152 12.0339 1.33127 11.2794 1.22982C10.5086 1.1262 9.49262 1.125 8.0625 1.125H6.5625C5.13239 1.125 4.11639 1.1262 3.34564 1.22982ZM3.75 6.5625C3.75 6.25184 4.00184 6 4.3125 6H10.3125C10.6232 6 10.875 6.25184 10.875 6.5625C10.875 6.87316 10.6232 7.125 10.3125 7.125H4.3125C4.00184 7.125 3.75 6.87316 3.75 6.5625ZM3.75 9.5625C3.75 9.25184 4.00184 9 4.3125 9H8.0625C8.37316 9 8.625 9.25184 8.625 9.5625C8.625 9.87316 8.37316 10.125 8.0625 10.125H4.3125C4.00184 10.125 3.75 9.87316 3.75 9.5625Z" fill="currentColor"></path></svg>
	</span>
}

// iconOverview is not in Charlin's frame, which only drew Logs, Settings and
// Members. Drawn to match theirs: 18px box, same weight, same rounded feel.
templ iconOverview() {
	<span class="flex size-[18px] shrink-0 items-center justify-center">
		<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7.5" height="7.5" rx="2"></rect><rect x="13.5" y="3" width="7.5" height="7.5" rx="2"></rect><rect x="3" y="13.5" width="7.5" height="7.5" rx="2"></rect><rect x="13.5" y="13.5" width="7.5" height="7.5" rx="2"></rect></svg>
	</span>
}

templ iconSessions() {
	<span class="flex size-[18px] shrink-0 items-center justify-center">
		<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3.2 1.9"></path></svg>
	</span>
}

templ iconDevices() {
	<span class="flex size-[18px] shrink-0 items-center justify-center">
		<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="6" y="2.5" width="12" height="19" rx="2.5"></rect><path d="M10.5 18.5h3"></path></svg>
	</span>
}

// iconErrors is drawn to match iconOverview: same 18px box, same stroke weight,
// same rounded corners. Charlin's frame has no glyph for it.
templ iconErrors() {
	<span class="flex size-[18px] shrink-0 items-center justify-center">
		<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.3 3.9 1.9 18.3a2 2 0 0 0 1.7 3h16.8a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z"></path><path d="M12 9v4.5"></path><path d="M12 17.2h.01"></path></svg>
	</span>
}

