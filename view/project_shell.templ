package view

import (
	"fmt"

	"github.com/google/uuid"
	"github.com/t0uh33d/code_scout/internal/domain"
)

// ProjectShellData is the chrome every project-scoped page shares.
type ProjectShellData struct {
	User      *domain.User
	ProjectID uuid.UUID
	// Project may be nil if it could not be loaded; the sidebar then falls back
	// to showing the id, rather than the page failing to render.
	Project *domain.Project
	// Active marks the sidebar item: "logs" or "settings". Session timeline and
	// network detail are children of the log viewer, so they pass "logs".
	Active string
}

func (d ProjectShellData) projectName() string {
	if d.Project != nil && d.Project.Name != "" {
		return d.Project.Name
	}
	return "Project"
}

func (d ProjectShellData) pageTitle() string {
	return fmt.Sprintf("Code Scout — %s", d.projectName())
}

// ProjectShell wraps every screen belonging to one project: top nav, a sidebar
// to move between that project's screens, and the content area. It replaces the
// per-page "Back to Projects" breadcrumb, which was the only navigation these
// pages had.
templ ProjectShell(d ProjectShellData) {
	@BaseLayout(d.pageTitle()) {
		<div class="min-h-screen bg-chinese-black">
			@TopNav(d.User)
			<div class="mx-auto max-w-[1280px] px-6 py-6">
				<div class="flex flex-col gap-6 md:flex-row md:gap-8">
					@projectSidebar(d)
					<main class="min-w-0 flex-1">
						{ children... }
					</main>
				</div>
			</div>
		</div>
	}
}

templ projectSidebar(d ProjectShellData) {
	<aside class="w-full shrink-0 md:w-[220px]">
		<a href="/" class="mb-4 inline-flex items-center gap-1 text-sm text-cs-muted transition-colors hover:text-white">
			<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
			All projects
		</a>
		<div class="mb-4">
			<!-- Renaming the project swaps this element by id, so it must keep it. -->
			<h2 id="project-shell-name" class="truncate text-base font-bold text-white">{ d.projectName() }</h2>
			<p class="truncate font-mono text-xs text-cs-muted">{ d.ProjectID.String() }</p>
		</div>
		<nav class="flex flex-row gap-1 md:flex-col">
			@projectNavItem("Logs", fmt.Sprintf("/project/%s/logs", d.ProjectID), d.Active == "logs")
			@projectNavItem("Settings", fmt.Sprintf("/project/%s/settings", d.ProjectID), d.Active == "settings")
		</nav>
	</aside>
}

templ projectNavItem(label string, href string, active bool) {
	<a
		href={ templ.SafeURL(href) }
		if active {
			aria-current="page"
		}
		class={ "rounded-lg px-3 py-2 text-sm no-underline transition-colors",
			templ.KV("bg-cs-card font-semibold text-white", active),
			templ.KV("text-cs-muted hover:bg-cs-card/60 hover:text-white", !active) }
	>{ label }</a>
}
