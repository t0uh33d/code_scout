package view

import (
	"github.com/t0uh33d/code_scout/internal/domain"
	"github.com/t0uh33d/code_scout/pkg/utils"
	"github.com/t0uh33d/code_scout/view/static"
)

type ChangePasswordData struct {
	User *domain.User
	// Forced is true when the account was sent here rather than choosing to
	// come. It removes the way out, because there is nowhere else to go.
	Forced bool
	Errors []utils.FieldError
}

// ChangePassword is a full page rather than a dialog: an account on a temporary
// password cannot reach anything else, so there is nothing to show behind it.
templ ChangePassword(d ChangePasswordData) {
	@BaseLayout("Code Scout — Change password") {
		{{ currentErr := fieldErrorFor(d.Errors, "current_password") }}
		{{ passwordErr := fieldErrorFor(d.Errors, "password") }}
		{{ confirmErr := fieldErrorFor(d.Errors, "confirm_password") }}
		<div class="flex min-h-screen items-center justify-center px-4">
			<div class="flex w-full max-w-[440px] flex-col items-center">
				<img src={ static.LOGIN_HEADER_IMAGE } class="mb-8 h-auto w-[300px]" alt="Code Scout"/>
				<div class="w-full rounded-2xl border border-eerie-black p-8">
					<h1 class="text-lg font-bold tracking-[0.18px] text-white">
						if d.Forced {
							Set your own password
						} else {
							Change your password
						}
					</h1>
					if d.Forced {
						<p class="mt-2 text-sm leading-relaxed text-cs-muted">
							You signed in with a password someone generated for you.
							Pick your own before you carry on.
						</p>
					}
					<!-- A plain form post, not HTMX: this response replaces the
					     session cookie and sends the browser somewhere else, and
					     both of those are things a full navigation does for free. -->
					<form method="POST" action="/change-password" class="mt-6 flex flex-col gap-5">
						if d.User != nil {
							<!-- Hidden but present so a password manager knows which
							     account this new password belongs to. -->
							<input type="hidden" name="email" autocomplete="username" value={ d.User.Email }/>
						}
						@passwordField("current_password", "Current password", "Enter the password you signed in with", "current-password", currentErr)
						@passwordField("password", "New password", "At least 6 characters", "new-password", passwordErr)
						@passwordField("confirm_password", "Re-enter new password", "Type it once more", "new-password", confirmErr)
						<button
							type="submit"
							class="mt-1 w-full rounded-lg bg-cs-primary py-3 text-sm font-semibold text-white transition-colors hover:bg-blue-600 active:bg-blue-700"
						>Save password</button>
					</form>
					if !d.Forced {
						<a href="/" class="mt-5 block text-center text-sm text-cs-muted no-underline transition-colors hover:text-white">Back to projects</a>
					} else {
						<form method="POST" action="/api/auth/logout" class="mt-5">
							<button type="submit" class="w-full text-center text-sm text-cs-muted transition-colors hover:text-white">Sign out instead</button>
						</form>
					}
				</div>
			</div>
		</div>
		<script>
			// Reaches the input as the button's previous sibling, so the same
			// handler serves all three fields without an id per button.
			function togglePassword(btn) {
				var input = btn.previousElementSibling;
				input.type = input.type === 'password' ? 'text' : 'password';
				btn.setAttribute('aria-pressed', input.type === 'text');
			}
		</script>
	}
}

templ passwordField(id, label, placeholder, autocomplete, errMsg string) {
	<div class="flex flex-col gap-[6px]">
		<label for={ id } class="text-sm font-medium text-fnt-platinum">{ label }</label>
		<div class="relative">
			<input
				id={ id }
				name={ id }
				type="password"
				placeholder={ placeholder }
				autocomplete={ autocomplete }
				required
				class={ "w-full rounded-lg border bg-cs-input px-4 py-3 pr-12 text-sm text-fnt-platinum transition-colors placeholder-arsenic focus:outline-none",
					templ.KV("border-cs-danger", errMsg != ""),
					templ.KV("border-cs-input-border focus:border-cs-primary", errMsg == "") }
			/>
			<button
				type="button"
				onclick="togglePassword(this)"
				class="absolute right-3 top-1/2 -translate-y-1/2 text-cs-primary transition-colors hover:opacity-80"
				aria-label="Toggle password visibility"
			>
				<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
			</button>
		</div>
		@fieldError(errMsg)
	</div>
}
