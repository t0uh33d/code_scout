package view

import (
	"fmt"
	"strconv"
	"time"

	"github.com/google/uuid"
	"github.com/getcodescout/code_scout/internal/domain"
	"github.com/getcodescout/code_scout/pkg/utils"
)

type SettingsData struct {
	User    *domain.User
	Project *domain.Project
	// HasSecret is false for a project whose secret row is missing, which the
	// credentials section explains rather than showing an empty field.
	HasSecret bool
	// CanManage gates the destructive and access controls. Read-only members
	// see the screen without them, rather than being denied the page.
	CanManage bool
	CanDelete bool
	Access    AccessPanelData
	// Tab is the pane to show: general, sdk, access or danger.
	Tab string
	// BaseURL is the address the SDK snippet tells an app to send logs to.
	BaseURL string
}

func (d SettingsData) shell() ProjectShellData {
	return ProjectShellData{User: d.User, ProjectID: d.Project.ID, Project: d.Project, Active: "settings"}
}

// settingsTab is one entry in the tab bar. Tabs a member cannot use are not
// rendered at all rather than shown disabled: a Viewer has no business seeing a
// Danger zone they cannot open.
type settingsTab struct {
	Key   string
	Label string
}

func (d SettingsData) tabs() []settingsTab {
	tabs := []settingsTab{{"general", "General"}}
	if d.CanManage {
		tabs = append(tabs, settingsTab{"sdk", "SDK setup"})
	}
	tabs = append(tabs, settingsTab{"access", "Access"})
	if d.CanDelete {
		tabs = append(tabs, settingsTab{"danger", "Danger zone"})
	}
	return tabs
}

// activeTab falls back to general for an unknown or forbidden tab, so a
// hand-typed ?tab= cannot render a pane the member is not allowed.
func (d SettingsData) activeTab() string {
	for _, t := range d.tabs() {
		if t.Key == d.Tab {
			return t.Key
		}
	}
	return "general"
}

templ SettingsPage(data SettingsData) {
	@ProjectShell(data.shell()) {
		<h1 class="text-xl font-bold text-white">Settings</h1>
		<p class="mt-1 text-sm text-cs-muted">Everything scoped to this one project.</p>
		@SettingsBody(data)
		<!-- The dialog host starts empty. Rotate and Delete fetch a modal into
		     it, and the response to either action empties it again. It lives
		     outside the swapped body so a tab change cannot remove it. -->
		<div id="confirm-host"></div>
	}
}

// SettingsBody is the tab bar plus the active pane. Switching tabs replaces the
// whole thing, because the underline has to move as well as the pane change.
//
// The tab buttons hx-get the same URL a browser would, so ?tab=sdk is a real
// address you can link to; the handler answers with just this fragment when the
// request came from htmx, and with the full page otherwise. hx-push-url writes
// it into the address bar so reload and back both work.
templ SettingsBody(data SettingsData) {
	{{ active := data.activeTab() }}
	<div id="settings-body" class="mt-5">
		<div class="flex flex-wrap items-center gap-6 border-b border-cs-border">
			for _, t := range data.tabs() {
				<button
					type="button"
					hx-get={ fmt.Sprintf("/project/%s/settings?tab=%s", data.Project.ID, t.Key) }
					hx-target="#settings-body"
					hx-swap="outerHTML"
					hx-push-url="true"
					if t.Key == active {
						aria-current="page"
					}
					class={ "-mb-px border-b-2 pb-3 text-sm transition-colors",
						templ.KV("border-cs-primary font-semibold text-cs-primary", t.Key == active),
						templ.KV("border-transparent text-cs-muted hover:text-white", t.Key != active) }
				>{ t.Label }</button>
			}
		</div>
		<div class="flex flex-col gap-4 pt-5">
			if !data.CanManage {
				<p class="rounded-lg border border-cs-border px-4 py-3 text-sm text-cs-muted">
					You have read access to this project. Ask a maintainer to change its settings or credentials.
				</p>
			}
			switch active {
				case "sdk":
					@paneSDK(data)
				case "access":
					@paneAccess(data)
				case "danger":
					@dangerZone(data.Project)
				default:
					@GeneralForm(GeneralFormData{
						ProjectID:         data.Project.ID,
						Name:              data.Project.Name,
						Description:       data.Project.Description,
						SessionSampleRate: data.Project.SessionSampleRate,
						CreatedAt:         data.Project.CreatedAt,
					})
			}
		</div>
	</div>
}

// paneSDK is the tab that makes the setup snippet retrievable. Before this it
// existed only in the response to creating the project, so closing the wizard
// meant never seeing it again.
templ paneSDK(d SettingsData) {
	@credentialsSection(d)
	<div class="rounded-xl border border-cs-border p-6">
		<div class="mb-4 flex items-center justify-between gap-4">
			<h2 class="text-base font-semibold text-white">Add this to your app</h2>
			<button
				type="button"
				onclick="navigator.clipboard.writeText(document.getElementById('settings-snippet').textContent);this.textContent='Copied'"
				class="shrink-0 rounded-lg border border-cs-border bg-cs-card px-3 py-1.5 text-xs font-semibold text-cs-muted transition-colors hover:text-white"
			>Copy</button>
		</div>
		<!-- The host is what the out-of-band swap replaces; the snippet inside
		     it is what the Copy button reads. -->
		<div id="settings-snippet-host">
			@SetupSnippet(d.Project.ID, "", d.BaseURL)
		</div>
		<p class="mt-3 text-xs leading-relaxed text-cs-muted">
			Reveal the secret above and it appears here too. Companion packages
			<span class="font-mono">code_scout_dio</span> and <span class="font-mono">code_scout_http</span> are one line each.
		</p>
	</div>
}

// SetupSnippet is swapped on its own when the secret is revealed, so the block
// people copy carries the real key rather than the mask.
templ SetupSnippet(projectID uuid.UUID, secret string, baseURL string) {
	<pre id="settings-snippet" class="overflow-x-auto rounded-lg border border-cs-border bg-chinese-black p-4 font-mono text-xs leading-relaxed text-cs-text">{ snippetFor(projectID, secret, baseURL) }</pre>
}

// SetupSnippetOOB rides along with the reveal response. Revealing the key is a
// request about the secret field, so the snippet updates out of band rather
// than the button having to target two places.
templ SetupSnippetOOB(projectID uuid.UUID, secret string, baseURL string) {
	<div id="settings-snippet-host" hx-swap-oob="true">
		@SetupSnippet(projectID, secret, baseURL)
	</div>
}

// snippetFor masks the secret until it has been revealed, so the delivered page
// never carries a live credential.
func snippetFor(projectID uuid.UUID, secret string, baseURL string) string {
	if secret == "" {
		secret = "••••••••••••••••••••••••••••••••"
	}
	return setupSnippet(&domain.ProjectDetails{ID: projectID, SecretKey: secret}, baseURL)
}

templ paneAccess(d SettingsData) {
	<div class="rounded-xl border border-cs-border p-6">
		<div class="mb-1 flex items-center justify-between gap-4">
			<h2 class="text-base font-semibold text-white">Who can see this project</h2>
			if d.User != nil && d.User.CanCreateProjects() {
				<a
					href="/settings?tab=members"
					class="shrink-0 rounded-lg border border-cs-border bg-cs-card px-3 py-1.5 text-xs font-semibold text-cs-muted no-underline transition-colors hover:text-white"
				>Manage members</a>
			}
		</div>
		@AccessPanel(d.Access)
	</div>
}

// GeneralFormData carries both the values to show and any validation errors, so
// the same template renders the first paint and every save response.
type GeneralFormData struct {
	ProjectID         uuid.UUID
	Name              string
	Description       string
	SessionSampleRate int
	CreatedAt         time.Time
	Errors            []utils.FieldError
	Saved             bool
}

// GeneralForm replaces itself on save. Because the form is the target, the
// server can answer with either the saved state or the same values plus inline
// errors, and the browser never has to decide which.
templ GeneralForm(d GeneralFormData) {
	{{ nameErr := fieldErrorFor(d.Errors, "name") }}
	{{ sampleErr := fieldErrorFor(d.Errors, "session_sample_rate") }}
	{{ formErr := fieldErrorFor(d.Errors, "form") }}
	<form
		id="general-form"
		hx-post={ fmt.Sprintf("/project/%s/settings/general", d.ProjectID) }
		hx-target="#general-form"
		hx-swap="outerHTML"
		hx-disabled-elt="find button[type='submit']"
		class="rounded-xl border border-cs-border p-6"
	>
		<h2 class="mb-5 text-base font-semibold text-white">General</h2>
		<div class="flex flex-col gap-5">
			<div class="flex flex-col gap-[6px]">
				<label for="project-name" class="text-sm font-medium text-cs-muted">Project name</label>
				<input
					id="project-name"
					name="name"
					type="text"
					value={ d.Name }
					required
					aria-describedby="project-name-error"
					class={ "w-full rounded-lg border bg-chinese-black px-4 py-3 text-sm text-white transition-colors focus:outline-none",
						templ.KV("border-cs-danger focus:border-cs-danger", nameErr != ""),
						templ.KV("border-cs-border focus:border-cs-primary", nameErr == "") }
				/>
				<span id="project-name-error">
					@fieldError(nameErr)
				</span>
			</div>
			<div class="flex flex-col gap-[6px]">
				<label for="project-desc" class="text-sm font-medium text-cs-muted">Description</label>
				<textarea
					id="project-desc"
					name="description"
					rows="3"
					placeholder="What is this app, and which environment is it?"
					class="w-full resize-none rounded-lg border border-cs-border bg-chinese-black px-4 py-3 text-sm text-white transition-colors placeholder:text-cs-placeholder focus:border-cs-primary focus:outline-none"
				>{ d.Description }</textarea>
			</div>
			<div class="flex flex-col gap-[6px]">
				<label for="project-sampling" class="text-sm font-medium text-cs-muted">Session sampling</label>
				<div class="flex items-center gap-3">
					<input
						id="project-sampling"
						name="session_sample_rate"
						type="number"
						min="0"
						max="100"
						step="1"
						value={ strconv.Itoa(d.SessionSampleRate) }
						required
						aria-describedby="project-sampling-error"
						class={ "w-24 rounded-lg border bg-chinese-black px-4 py-3 text-sm text-white transition-colors focus:outline-none",
							templ.KV("border-cs-danger focus:border-cs-danger", sampleErr != ""),
							templ.KV("border-cs-border focus:border-cs-primary", sampleErr == "") }
					/>
					<span class="text-sm text-cs-muted">% of app launches</span>
				</div>
				<p class="text-xs leading-relaxed text-cs-muted">
					Whole sessions, not individual logs, so a session you keep keeps its whole timeline. Apps pick this up the next time they start.
				</p>
				<span id="project-sampling-error">
					@fieldError(sampleErr)
				</span>
			</div>
			if formErr != "" {
				<p class="text-sm text-cs-danger">{ formErr }</p>
			}
			<div class="flex flex-wrap items-center justify-between gap-3">
				if !d.CreatedAt.IsZero() {
					<span class="text-xs text-cs-muted">Created { fmtTime(d.CreatedAt, DateLong) }</span>
				} else {
					<span></span>
				}
				<div class="flex items-center gap-3">
					if d.Saved {
						<span class="text-xs text-cs-success">Saved</span>
					}
					<button
						type="submit"
						class="rounded-lg bg-cs-primary px-5 py-2 font-display text-sm font-semibold text-cs-btn-text transition-colors hover:bg-blue-600"
					>Save changes</button>
				</div>
			</div>
		</div>
	</form>
}

templ credentialsSection(d SettingsData) {
	<div class="rounded-xl border border-cs-border p-6">
		<h2 class="mb-5 text-base font-semibold text-white">API credentials</h2>
		<div class="flex flex-col gap-5">
			@credentialRow("Project ID", d.Project.ID.String())
			if d.HasSecret {
				@SecretField(d.Project.ID, "", false)
				<div class="rounded-lg border border-amber-500/30 bg-amber-500/5 p-4">
					<p class="text-sm text-cs-muted">
						Rotating the secret breaks every app still using the old one. They keep buffering logs on the device until you update their config.
					</p>
					<button
						type="button"
						hx-get={ fmt.Sprintf("/project/%s/settings/confirm?action=rotate", d.Project.ID) }
						hx-target="#confirm-host"
						hx-swap="innerHTML"
						class="mt-4 rounded-lg border border-cs-danger/30 bg-cs-danger/10 px-4 py-2 text-sm font-semibold text-cs-danger transition-colors hover:bg-cs-danger/20"
					>Rotate secret</button>
				</div>
			} else {
				<!-- The field still renders, masked and empty, because the rotate
				     response targets #secret-field. Without it here, generating a
				     secret would succeed on the server and swap into nothing. -->
				@SecretField(d.Project.ID, "", false)
				<div class="rounded-lg border border-amber-500/30 bg-amber-500/5 p-4">
					<p class="text-sm text-cs-muted">This project has no secret key on file. Generate one to connect an app.</p>
					<button
						type="button"
						hx-get={ fmt.Sprintf("/project/%s/settings/confirm?action=rotate", d.Project.ID) }
						hx-target="#confirm-host"
						hx-swap="innerHTML"
						class="mt-4 rounded-lg bg-cs-primary px-4 py-2 font-display text-sm font-semibold text-cs-btn-text transition-colors hover:bg-blue-600"
					>Generate secret</button>
				</div>
			}
		</div>
	</div>
}

// SecretField is both the masked control and the revealed one. The page ships
// masked and the real key exists only in the response to an explicit request,
// so the secret is never in the delivered HTML.
templ SecretField(projectID uuid.UUID, secret string, revealed bool) {
	<div id="secret-field" class="flex flex-col gap-[6px]">
		<label class="text-xs font-medium uppercase tracking-wider text-cs-muted">Secret key</label>
		<div class="flex items-center gap-2">
			if revealed {
				<input
					readonly
					value={ secret }
					onclick="this.select()"
					aria-label="Secret key"
					class="w-full rounded-lg border border-cs-input-border bg-cs-input px-4 py-2.5 font-mono text-sm text-white transition-colors focus:border-cs-primary focus:outline-none"
				/>
				<button
					type="button"
					onclick="navigator.clipboard.writeText(this.previousElementSibling.value);this.textContent='Copied'"
					class="shrink-0 rounded-lg border border-cs-border bg-cs-card px-4 py-2.5 text-sm font-semibold text-cs-muted transition-colors hover:text-white"
				>Copy</button>
				<button
					type="button"
					hx-get={ fmt.Sprintf("/project/%s/settings/secret?hide=1&snippet=1", projectID) }
					hx-target="#secret-field"
					hx-swap="outerHTML"
					class="shrink-0 rounded-lg border border-cs-border bg-cs-card px-4 py-2.5 text-sm font-semibold text-cs-muted transition-colors hover:text-white"
				>Hide</button>
			} else {
				<input
					readonly
					value="••••••••••••••••••••••••••••••••"
					aria-label="Secret key, hidden"
					class="w-full rounded-lg border border-cs-input-border bg-cs-input px-4 py-2.5 font-mono text-sm text-cs-muted"
				/>
				<button
					type="button"
					hx-get={ fmt.Sprintf("/project/%s/settings/secret?snippet=1", projectID) }
					hx-target="#secret-field"
					hx-swap="outerHTML"
					class="shrink-0 rounded-lg border border-cs-border bg-cs-card px-4 py-2.5 text-sm font-semibold text-cs-muted transition-colors hover:text-white"
				>Reveal</button>
			}
		</div>
		if revealed {
			<p class="text-xs text-cs-muted">Anyone holding this key can write logs to this project.</p>
		}
	</div>
}

templ dangerZone(project *domain.Project) {
	<div class="rounded-xl border border-cs-danger/30 p-6">
		<h2 class="mb-2 text-base font-semibold text-cs-danger">Danger zone</h2>
		<div class="flex flex-wrap items-center justify-between gap-4">
			<p class="max-w-xl text-sm text-cs-muted">
				Deleting this project removes it and its credentials straight away. Its logs stop being reachable and are cleared by the next nightly cleanup. This cannot be undone.
			</p>
			<button
				type="button"
				hx-get={ fmt.Sprintf("/project/%s/settings/confirm?action=delete", project.ID) }
				hx-target="#confirm-host"
				hx-swap="innerHTML"
				class="shrink-0 rounded-lg border border-cs-danger/30 bg-cs-danger/10 px-4 py-2 text-sm font-semibold text-cs-danger transition-colors hover:bg-cs-danger/20"
			>Delete project</button>
		</div>
	</div>
}

// ShellNameOOB updates the sidebar heading after a rename. It renders the same
// templ the sidebar does, so the swapped-in heading cannot drift away from the
// one it replaces — which is exactly what happened when these were two copies.
templ ShellNameOOB(name string) {
	@projectShellName(name, true)
}

// SettingsError is the fragment shown inside the confirm dialog when an action
// fails. It is deliberately returned with a 200: HTMX ignores the body of a
// non-2xx response, so an error page sent as 500 would simply never appear.
templ SettingsError(msg string) {
	<p class="text-sm text-cs-danger">{ msg }</p>
}
