package view

import (
	"fmt"

	"github.com/google/uuid"
	"github.com/t0uh33d/code_scout/internal/domain"
)

// The Sessions screen, following the prototype's s-sessions: one row per app
// launch, and each row is a way into that launch's timeline.

type SessionsData struct {
	User      *domain.User
	Project   *domain.Project
	ProjectID uuid.UUID
	Sessions  []domain.SessionSummary
	Total     int64
	Users     int64
}

func (d SessionsData) shell() ProjectShellData {
	return ProjectShellData{User: d.User, ProjectID: d.ProjectID, Project: d.Project, Active: "sessions"}
}

templ SessionsPage(d SessionsData) {
	@ProjectShell(d.shell()) {
		<div class="flex flex-wrap items-baseline justify-between gap-2">
			<h1 class="text-xl font-bold text-white">Sessions</h1>
			if d.Total > 0 {
				<span class="text-xs text-cs-muted">
					{ fmt.Sprintf("%s · %s", sessionsLabel(d.Total), usersLabel(d.Users)) }
				</span>
			}
		</div>
		<p class="mt-1 text-sm text-cs-muted">One row per app launch.</p>
		if len(d.Sessions) == 0 {
			@sessionsEmpty()
		} else {
			<div class="mt-5 overflow-x-auto rounded-xl border border-cs-border">
				<table class="w-full min-w-[720px] border-collapse text-sm">
					<thead>
						<tr class="border-b border-cs-border text-left text-[10px] font-semibold uppercase tracking-wider text-cs-placeholder">
							<th class="px-4 py-3 font-semibold">Session</th>
							<th class="px-4 py-3 font-semibold">Device</th>
							<th class="px-4 py-3 font-semibold">User</th>
							<th class="px-4 py-3 font-semibold">Started</th>
							<th class="px-4 py-3 text-right font-semibold">Logs</th>
							<th class="px-4 py-3 text-right font-semibold">Errors</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-cs-border">
						for _, s := range d.Sessions {
							@sessionRow(d.ProjectID, s)
						}
					</tbody>
				</table>
			</div>
			<p class="mt-3 text-xs text-cs-muted">
				Sessions marked <span class="text-white">anonymous</span> never called <code class="font-mono">setUser()</code>. Identity is opt-in, never inferred.
			</p>
		}
	}
}

// The row is a link to the timeline, but the device cell is a link to that
// phone. A nested anchor is invalid HTML and the browser would drop one of
// them, so the row link covers the cells around the device cell rather than
// wrapping the whole row.
templ sessionRow(projectID uuid.UUID, s domain.SessionSummary) {
	<tr data-session-row class="transition-colors hover:bg-eerie-black/40">
		<td class="px-4 py-3">
			<a
				href={ templ.SafeURL(fmt.Sprintf("/project/%s/session/%s", projectID, s.ID)) }
				class="font-mono text-xs text-cs-primary no-underline hover:underline"
			>{ shortID(s.ID) }</a>
		</td>
		<td class="px-4 py-3">
			if s.InstallationID != nil {
				<a
					href={ templ.SafeURL(fmt.Sprintf("/project/%s/device/%s", projectID, s.InstallationID)) }
					class="text-cs-primary no-underline hover:underline"
				>{ s.DeviceLabel() }</a>
			} else {
				<span class="text-cs-muted">{ s.DeviceLabel() }</span>
			}
		</td>
		<td class={ "px-4 py-3", templ.KV("font-mono text-xs", s.IsIdentified()), templ.KV("text-cs-muted", !s.IsIdentified()) }>
			<!-- A named user is a link into every log they ever produced, which
			     is the question the column tends to raise. An anonymous session
			     has nothing to scope to, so it stays plain text. -->
			if s.IsIdentified() && s.UserID != nil {
				<a
					href={ templ.SafeURL(filterHref(projectID, domain.SearchFilter{
						Session: domain.SessionScope{User: *s.UserID},
					})) }
					data-scope-link="user"
					title="Show every log from this user"
					class="text-cs-primary no-underline hover:underline"
				>{ s.UserLabel() }</a>
			} else {
				{ s.UserLabel() }
			}
		</td>
		<td class="px-4 py-3 font-mono text-xs text-cs-muted">
			{ fmtTime(s.StartedAt, "15:04:05") }
			<span class="ml-1 opacity-70">{ shortDuration(s.Duration()) }</span>
		</td>
		<td class="px-4 py-3 text-right font-mono text-xs tabular-nums text-white">{ commaGroup(s.Logs) }</td>
		<td class={ "px-4 py-3 text-right font-mono text-xs tabular-nums", templ.KV("text-cs-danger", s.Errors > 0), templ.KV("text-cs-muted", s.Errors == 0) }>
			{ commaGroup(s.Errors) }
		</td>
	</tr>
}

templ sessionsEmpty() {
	<div class="mt-5 flex flex-col items-center gap-2 rounded-xl border border-cs-border py-16 text-center">
		<p class="text-lg font-bold tracking-[0.18px] text-white">No sessions yet</p>
		<p class="text-sm tracking-[0.14px] text-cs-muted">
			A session appears the first time an app launch reports in.
		</p>
	</div>
}

func usersLabel(n int64) string {
	if n == 1 {
		return "1 user"
	}
	return fmt.Sprintf("%s users", commaGroup(n))
}

// shortID is the first block of a UUID. Long enough to tell sessions apart on a
// screen, short enough to sit in a table cell.
func shortID(id uuid.UUID) string {
	s := id.String()
	if len(s) < 8 {
		return s
	}
	return s[:8]
}
