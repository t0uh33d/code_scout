package view

import (
	"github.com/getcodescout/code_scout/internal/domain"
	"github.com/getcodescout/code_scout/pkg/utils"
)

// TokensData fills the API tokens pane on /settings. Per user, not per
// instance: the list is always the signed-in account's own tokens, and the
// handler never takes a user id from the request.
type TokensData struct {
	Tokens []domain.PersonalAccessToken
	// Revealed is the plaintext of a token minted by THIS response, shown
	// exactly once. Only the create POST ever sets it; a GET cannot, so a
	// refresh cannot resurrect it. Empty means nothing to reveal.
	Revealed     string
	RevealedName string
	Errors       []utils.FieldError
}

// TokensPane is the whole tab: explainer, reveal card, create form, list. The
// create and revoke forms target the pane and swap it whole, so every path
// re-renders one consistent state.
templ TokensPane(d TokensData) {
	<div id="tokens-pane" class="max-w-3xl">
		<div class="rounded-xl border border-cs-border bg-cs-card p-6">
			<h2 class="text-base font-semibold text-white">API tokens</h2>
			<p class="mt-2 text-sm text-cs-muted">
				A token lets tools outside this dashboard read Code Scout as you: an AI coding
				agent over MCP, or a script against the API. It sees exactly the projects you can
				see, and it can only ever read. No tool behind a token can change a project, a
				setting, or anything on a paired device.
			</p>
			if d.Revealed != "" {
				@TokenRevealCard(d.RevealedName, d.Revealed)
			}
			@TokenCreateForm(d)
			@TokenRows(d.Tokens)
		</div>
	</div>
}

// TokenRevealCard shows a fresh token's plaintext, the only time it exists
// outside the creator's clipboard. The server keeps a hash, so this exact
// string cannot be shown again.
templ TokenRevealCard(name string, plaintext string) {
	<div class="mt-5 rounded-lg border border-cs-primary/50 bg-cs-primary/5 p-4">
		<p class="text-sm font-medium text-white">{ name } is ready</p>
		<p class="mt-1 text-xs text-cs-muted">
			Copy it now. This is the only time it is shown. The server keeps only a hash.
		</p>
		<div class="mt-3 flex items-center gap-2">
			<input
				type="text"
				readonly
				value={ plaintext }
				class="w-full rounded-lg border border-cs-border bg-chinese-black px-3 py-2 font-mono text-xs text-white"
			/>
			<button
				type="button"
				onclick="navigator.clipboard.writeText(this.previousElementSibling.value);this.textContent='Copied'"
				class="shrink-0 rounded-lg border border-cs-border px-4 py-2 text-xs text-cs-muted transition-colors hover:border-cs-primary hover:text-white"
			>Copy</button>
		</div>
	</div>
}

templ TokenCreateForm(d TokensData) {
	{{ nameErr := fieldErrorFor(d.Errors, "name") }}
	<form
		hx-post="/settings/tokens"
		hx-target="#tokens-pane"
		hx-swap="outerHTML"
		hx-disabled-elt="find button[type='submit']"
		class="mt-5 flex flex-wrap items-end gap-3"
	>
		<div class="flex min-w-56 flex-1 flex-col gap-[6px]">
			<label for="token-name" class="text-sm font-medium text-cs-muted">Name</label>
			<input
				type="text"
				id="token-name"
				name="name"
				placeholder="What will use it? e.g. Claude Code on my laptop"
				class={ "w-full rounded-lg border bg-chinese-black px-4 py-3 text-sm text-white transition-colors focus:outline-none",
					templ.KV("border-cs-danger", nameErr != ""),
					templ.KV("border-cs-border focus:border-cs-primary", nameErr == "") }
			/>
			@fieldError(nameErr)
		</div>
		<div class="flex flex-col gap-[6px]">
			<label for="token-expiry" class="text-sm font-medium text-cs-muted">Expires</label>
			<select
				id="token-expiry"
				name="expires"
				class="rounded-lg border border-cs-border bg-chinese-black px-4 py-3 text-sm text-white focus:border-cs-primary focus:outline-none"
			>
				<option value="90d" selected>in 90 days</option>
				<option value="30d">in 30 days</option>
				<option value="never">never</option>
			</select>
		</div>
		<button
			type="submit"
			class="rounded-lg bg-cs-primary px-5 py-3 font-display text-sm font-semibold text-cs-btn-text transition-colors hover:bg-blue-600"
		>Create token</button>
	</form>
}

templ TokenRows(tokens []domain.PersonalAccessToken) {
	if len(tokens) == 0 {
		<p class="mt-6 text-sm text-cs-muted">No tokens yet. Create one above to connect a tool.</p>
	} else {
		<div class="mt-6 overflow-x-auto">
			<table class="w-full text-left text-sm">
				<thead>
					<tr class="border-b border-cs-border text-xs uppercase tracking-wide text-cs-muted">
						<th class="pb-2 pr-4 font-medium">Name</th>
						<th class="pb-2 pr-4 font-medium">Token</th>
						<th class="pb-2 pr-4 font-medium">Created</th>
						<th class="pb-2 pr-4 font-medium">Last used</th>
						<th class="pb-2 pr-4 font-medium">Expires</th>
						<th class="pb-2 font-medium"></th>
					</tr>
				</thead>
				<tbody>
					for _, t := range tokens {
						<tr class="border-b border-cs-border/50">
							<td class="py-3 pr-4 text-white">{ t.Name }</td>
							<td class="py-3 pr-4 font-mono text-xs text-cs-muted">{ "csp_…" + t.Suffix }</td>
							<td class="py-3 pr-4 text-cs-muted">{ fmtTime(t.CreatedAt, DateShort) }</td>
							<td class="py-3 pr-4 text-cs-muted">
								if t.LastUsedAt != nil {
									{ fmtTime(*t.LastUsedAt, DateTimeShort) }
								} else {
									never
								}
							</td>
							<td class="py-3 pr-4 text-cs-muted">
								if t.ExpiresAt != nil {
									{ fmtTime(*t.ExpiresAt, DateShort) }
								} else {
									never
								}
							</td>
							<td class="py-3 text-right">
								<button
									type="button"
									hx-post={ "/settings/tokens/" + t.ID.String() + "/revoke" }
									hx-target="#tokens-pane"
									hx-swap="outerHTML"
									hx-confirm={ "Revoke " + t.Name + "? Anything using it stops working immediately." }
									class="rounded-lg border border-cs-border px-3 py-1.5 text-xs text-cs-muted transition-colors hover:border-cs-danger hover:text-cs-danger"
								>Revoke</button>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}
