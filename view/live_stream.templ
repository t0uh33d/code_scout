package view

import (
	"fmt"

	"github.com/getcodescout/code_scout/internal/domain"
)

// LiveStreamData is the screen that watches one device — prototype s-stream.
type LiveStreamData struct {
	Project *domain.Project
	User    *domain.User
	Session domain.LiveSession
	// Found is false for a session this node has never heard of, or one that
	// ended long enough ago to be forgotten.
	Found bool
}

templ LiveStreamPage(d LiveStreamData) {
	@ProjectShell(ProjectShellData{
		User:      d.User,
		ProjectID: d.Project.ID,
		Project:   d.Project,
		Active:    "live",
	}) {
		@LiveStreamBody(d)
	}
}

templ LiveStreamBody(d LiveStreamData) {
	<div class="flex flex-col gap-4 py-2">
		<a
			href={ templ.SafeURL(fmt.Sprintf("/project/%s/live", d.Project.ID)) }
			class="text-sm text-cs-muted no-underline transition-colors hover:text-white"
		>← Back to live devices</a>
		if !d.Found {
			@liveStreamGone(d)
		} else {
			@liveStreamHeader(d)
			@liveStreamTabs(d)
			// Every pane stays in the DOM and is toggled rather than swapped.
			// The one SSE connection feeds both the logs list and the network
			// table, and swapping either out would drop the stream and lose
			// everything that arrived while you were away.
			<div data-live-pane="logs">
				@liveStreamFilters()
				@liveStreamList(d)
			</div>
			<div data-live-pane="net" hidden>
				@liveNetworkPane()
			</div>
			<div data-live-pane="db" hidden>
				<div id="db-pane-host">
					<p class="py-10 text-center text-sm text-cs-muted">Loading…</p>
				</div>
			</div>
			@LivePaneScript()
		}
	</div>
}

// The Logs / Network / Database switch.
//
// Logs and Network render from the stream that is already flowing; only the
// Database button carries an hx-get, so that pane is fetched when it is opened
// and not before: every request in it is a round trip through a phone, and an
// app nobody asks about should not be queried because somebody opened a live
// session.
//
// Not `once`. The first click often lands while the phone is in somebody's
// pocket, which answers "the device did not answer" — and the pane it renders
// then has nothing in it that could ask again, so the tab was the only way
// back and `once` had already spent it. Reloading the whole page was the only
// remedy. Refetching on every click costs one round trip and is what a person
// pressing the tab again already expects.
templ liveStreamTabs(d LiveStreamData) {
	<div class="flex items-center gap-3">
		<div class="inline-flex gap-1.5 rounded-xl bg-cs-container p-1.5">
			<button
				type="button" data-live-tab="logs" aria-pressed="true"
				class="rounded-lg bg-cs-card px-4 py-1.5 text-sm font-medium text-cs-muted aria-pressed:bg-cs-primary aria-pressed:font-semibold aria-pressed:text-cs-btn-text"
			>Logs</button>
			<button
				type="button" data-live-tab="net" aria-pressed="false"
				class="rounded-lg bg-cs-card px-4 py-1.5 text-sm font-medium text-cs-muted aria-pressed:bg-cs-primary aria-pressed:font-semibold aria-pressed:text-cs-btn-text"
			>Network <span data-live-net-count class="font-mono text-[11px] opacity-70"></span></button>
			<button
				type="button" data-live-tab="db" aria-pressed="false"
				hx-get={ fmt.Sprintf("/project/%s/live/%s/db", d.Project.ID, d.Session.ID) }
				hx-target="#db-pane-host"
				hx-swap="innerHTML"
				hx-indicator="#db-busy"
				class="rounded-lg bg-cs-card px-4 py-1.5 text-sm font-medium text-cs-muted aria-pressed:bg-cs-primary aria-pressed:font-semibold aria-pressed:text-cs-btn-text"
			>Database</button>
		</div>
		<span id="db-busy" class="htmx-indicator text-xs text-cs-muted">Asking the device…</span>
	</div>
}

// LivePaneScript toggles the two panes.
//
// Delegated from document rather than bound to the buttons, because everything
// inside the database pane is replaced by htmx as you browse and a listener
// attached to an element does not survive its element being swapped.
templ LivePaneScript() {
	<script type="text/javascript">
		document.addEventListener('click', function (e) {
			const tab = e.target.closest('[data-live-tab]');
			if (!tab) return;
			const wanted = tab.dataset.liveTab;
			document.querySelectorAll('[data-live-tab]').forEach(function (b) {
				b.setAttribute('aria-pressed', String(b.dataset.liveTab === wanted));
			});
			document.querySelectorAll('[data-live-pane]').forEach(function (p) {
				p.hidden = p.dataset.livePane !== wanted;
			});
		});
	</script>
}

templ liveStreamGone(d LiveStreamData) {
	<div class="rounded-xl border border-cs-border p-8 text-center">
		<h1 class="text-lg font-semibold text-white">That session is over</h1>
		<p class="mx-auto mt-2 max-w-[420px] text-sm text-cs-muted">
			Live sessions are not stored. Once a device disconnects its stream is gone —
			anything it had already uploaded is still in the log viewer.
		</p>
		<a
			href={ templ.SafeURL(fmt.Sprintf("/project/%s/live", d.Project.ID)) }
			class="mt-5 inline-block rounded-lg bg-cs-primary px-5 py-2 text-sm font-semibold text-cs-btn-text no-underline transition-colors hover:bg-blue-600"
		>Start another</a>
	</div>
}

templ liveStreamHeader(d LiveStreamData) {
	<div class="flex flex-wrap items-center justify-between gap-3">
		<h1 class="text-2xl font-bold text-white">{ d.Session.Device.Label() }</h1>
		<div class="flex flex-wrap items-center gap-2">
			<span id="watching-label" class="text-xs text-cs-muted">{ watchingLabel(d.Session.Watchers) }</span>
			<!-- The dot animates only while connected; the script swaps this
			     whole badge to a still one when the stream ends. -->
			<span id="live-badge" class="inline-flex items-center gap-1.5 rounded-full bg-cs-success/10 px-2.5 py-1 text-xs font-semibold text-cs-success">
				<span class="size-1.5 animate-pulse rounded-full bg-cs-success"></span>Live
			</span>
			<button type="button" data-live-pause class="rounded-lg border border-cs-border bg-cs-card px-3 py-1.5 text-xs font-semibold text-cs-muted transition-colors hover:text-white">Pause</button>
			<button type="button" data-live-clear class="rounded-lg border border-cs-border bg-cs-card px-3 py-1.5 text-xs font-semibold text-cs-muted transition-colors hover:text-white">Clear</button>
			<!--
			  Ending is a POST, so it goes through htmx rather than a link.
			  hx-confirm puts a browser confirm in front of it: the device stops
			  streaming for everyone watching, not just for whoever clicked.
			  The response is the devices list, and HX-Redirect is not used —
			  hx-target sends this one straight back to the list page instead.
			-->
			<button
				type="button"
				hx-post={ fmt.Sprintf("/project/%s/live/%s/end", d.Project.ID, d.Session.ID) }
				hx-confirm="End this session? The device stops streaming for everyone watching it."
				hx-target="body"
				hx-push-url={ fmt.Sprintf("/project/%s/live", d.Project.ID) }
				class="rounded-lg border border-cs-danger/40 bg-cs-danger/5 px-3 py-1.5 text-xs font-semibold text-cs-danger transition-colors hover:bg-cs-danger/10"
			>End session</button>
		</div>
	</div>
}

// liveStreamFilters is the level row. Filtering happens in the browser rather
// than at the server: the events are already here, and a round trip to hide a
// row would make a live tail feel like a form.
templ liveStreamFilters() {
	<div class="flex flex-wrap items-center gap-2 rounded-xl border border-cs-border px-4 py-3">
		<span class="mr-1 text-xs font-semibold uppercase tracking-wide text-cs-placeholder">Level</span>
		@liveLevelToggle("fatal", "Fatal", true)
		@liveLevelToggle("error", "Error", true)
		@liveLevelToggle("warning", "Warn", true)
		@liveLevelToggle("info", "Info", true)
		@liveLevelToggle("debug", "Debug", false)
		@liveLevelToggle("verbose", "Verbose", false)
		<input
			data-live-highlight
			type="text"
			placeholder="Highlight…"
			class="ml-auto w-40 rounded-lg border border-cs-border bg-chinese-black px-3 py-1.5 font-mono text-xs text-white placeholder:text-cs-placeholder focus:border-cs-primary focus:outline-none"
		/>
	</div>
}

// aria-pressed carries the state rather than a class, so the button is
// meaningful to a screen reader and the script has one place to read it from.
templ liveLevelToggle(level string, label string, on bool) {
	<button
		type="button"
		data-live-level={ level }
		aria-pressed={ fmt.Sprintf("%t", on) }
		class="rounded-full border border-cs-border px-3 py-1 text-xs font-semibold transition-colors aria-pressed:border-transparent aria-pressed:bg-cs-container aria-pressed:text-white text-cs-placeholder hover:text-white"
	>{ label }</button>
}

templ liveStreamList(d LiveStreamData) {
	<div class="rounded-xl border border-cs-border">
		<div class="flex items-center justify-between gap-3 border-b border-cs-border px-4 py-2.5">
			<span id="live-status" class="text-xs text-cs-muted">Connecting…</span>
			<label class="flex items-center gap-2 text-xs text-cs-muted">
				<input type="checkbox" data-live-autoscroll checked class="accent-cs-primary"/>
				Auto-scroll
			</label>
		</div>
		<!-- Fixed height so the newest row is always in the same place on screen
		     rather than the page growing under the pointer. -->
		<div
			id="live-stream"
			data-events-url={ fmt.Sprintf("/project/%s/live/%s/events", d.Project.ID, d.Session.ID) }
			class="h-[520px] overflow-y-auto px-2 py-2 font-mono text-xs"
		>
			<p id="live-empty" class="px-2 py-6 text-cs-muted">Waiting for the app to log something.</p>
		</div>
	</div>
	@liveStreamScript()
}

// liveStreamScript is the one screen in CodeScout that genuinely needs a
// client-side loop: rows arrive on their own rather than in response to
// anything a person did, so there is no htmx trigger to hang them off.
//
// EventSource rather than a WebSocket because a watcher only ever receives.
// The browser handles reconnection, and a proxy that would buffer a socket
// upgrade usually passes text/event-stream straight through.
//
// Not the htmx SSE extension, which the layout does load: that extension swaps
// server-rendered HTML in, and this screen needs the events themselves to
// filter by level, pause, and cap the row count in the browser.
templ liveStreamScript() {
	<script>
	(function () {
	  const stream = document.getElementById('live-stream')
	  if (!stream || stream.dataset.wired) return
	  stream.dataset.wired = '1'

	  const status = document.getElementById('live-status')
	  const empty = document.getElementById('live-empty')
	  const badge = document.getElementById('live-badge')
	  const watching = document.getElementById('watching-label')
	  const pauseBtn = document.querySelector('[data-live-pause]')
	  const clearBtn = document.querySelector('[data-live-clear]')
	  const autoscroll = document.querySelector('[data-live-autoscroll]')
	  const highlight = document.querySelector('[data-live-highlight]')

	  // Rows are capped. A device left streaming over lunch would otherwise
	  // grow the DOM until the tab is unusable, and nobody scrolls back
	  // through twenty thousand lines anyway.
	  const MAX_ROWS = 2000

	  let paused = false
	  // While paused, events queue rather than being dropped: pausing is for
	  // reading something, not for missing what happens next.
	  let queued = []

	  const LEVEL_COLOURS = {
	    fatal: 'text-cs-fatal', error: 'text-cs-danger', warning: 'text-cs-warning',
	    info: 'text-cs-info', debug: 'text-cs-muted', verbose: 'text-cs-placeholder',
	    system: 'text-cs-muted',
	  }

	  function enabledLevels() {
	    const on = new Set()
	    document.querySelectorAll('[data-live-level]').forEach(function (b) {
	      if (b.getAttribute('aria-pressed') === 'true') on.add(b.dataset.liveLevel)
	    })
	    return on
	  }

	  function applyFilter() {
	    const on = enabledLevels()
	    const needle = (highlight ? highlight.value : '').toLowerCase()
	    stream.querySelectorAll('[data-row-level]').forEach(function (row) {
	      const levelOk = on.has(row.dataset.rowLevel)
	      const textOk = !needle || row.textContent.toLowerCase().includes(needle)
	      row.hidden = !(levelOk && textOk)
	    })
	  }

	  document.querySelectorAll('[data-live-level]').forEach(function (b) {
	    b.addEventListener('click', function () {
	      b.setAttribute('aria-pressed', b.getAttribute('aria-pressed') === 'true' ? 'false' : 'true')
	      applyFilter()
	    })
	  })
	  if (highlight) highlight.addEventListener('input', applyFilter)

	  if (pauseBtn) {
	    pauseBtn.addEventListener('click', function () {
	      paused = !paused
	      pauseBtn.textContent = paused ? 'Resume' : 'Pause'
	      if (!paused) {
	        const pending = queued
	        queued = []
	        pending.forEach(addRow)
	        applyFilter()
	        scrollIfWanted()
	      }
	    })
	  }

	  if (clearBtn) {
	    clearBtn.addEventListener('click', function () {
	      stream.querySelectorAll('[data-row-level]').forEach(function (r) { r.remove() })
	      if (empty) empty.hidden = false
	    })
	  }

	  function scrollIfWanted() {
	    if (autoscroll && autoscroll.checked) stream.scrollTop = stream.scrollHeight
	  }

	  function timeOf(iso) {
	    const d = new Date(iso)
	    if (isNaN(d)) return ''
	    const two = function (n) { return String(n).padStart(2, '0') }
	    return two(d.getHours()) + ':' + two(d.getMinutes()) + ':' + two(d.getSeconds()) +
	      '.' + String(d.getMilliseconds()).padStart(3, '0')
	  }

	  function addRow(ev) {
	    const log = ev.log || {}
	    const level = (log.level || 'info').toLowerCase()

	    const row = document.createElement('div')
	    row.dataset.rowLevel = level
	    row.className = 'flex gap-3 px-2 py-1 hover:bg-cs-container'

	    const t = document.createElement('span')
	    t.className = 'shrink-0 text-cs-placeholder'
	    t.textContent = timeOf(ev.at)

	    const badge = document.createElement('span')
	    badge.className = 'w-14 shrink-0 font-semibold ' + (LEVEL_COLOURS[level] || 'text-cs-muted')
	    badge.textContent = level

	    // textContent, never innerHTML: a log message is whatever the app put
	    // in it, and the app is not a source we can trust with markup.
	    const msg = document.createElement('span')
	    msg.className = 'min-w-0 flex-1 break-words text-cs-text'
	    msg.textContent = log.message || ''

	    row.append(t, badge, msg)
	    stream.appendChild(row)
	    if (empty) empty.hidden = true

	    let extra = stream.querySelectorAll('[data-row-level]').length - MAX_ROWS
	    while (extra-- > 0) {
	      const first = stream.querySelector('[data-row-level]')
	      if (!first) break
	      first.remove()
	    }
	  }

	  // A visible marker rather than a silent jump in the numbers. Whoever is
	  // watching needs to know the thing they are looking for might have
	  // happened in the gap.
	  function addGap(count) {
	    const row = document.createElement('div')
	    row.className = 'my-1 px-2 py-1 text-center text-cs-warning'
	    row.textContent = count === 1
	      ? '1 event was missed while reconnecting'
	      : count + ' events were missed while reconnecting'
	    stream.appendChild(row)
	    if (empty) empty.hidden = true
	    scrollIfWanted()
	  }

	  function endStream(reason) {
	    if (status) status.textContent = reason || 'The session ended.'
	    if (badge) {
	      badge.className = 'inline-flex items-center gap-1.5 rounded-full bg-cs-border px-2.5 py-1 text-xs font-semibold text-cs-muted'
	      badge.textContent = 'Ended'
	    }
	    source.close()
	  }

	  const source = new EventSource(stream.dataset.eventsUrl)

	  source.addEventListener('connected', function (e) {
	    if (status) status.textContent = 'Connected. Waiting for events.'
	    // The server says how many events fell out of its replay buffer while
	    // we were away. Zero is the normal case; anything else is a hole in
	    // the timeline, and a timeline with an unmarked hole is worse than one
	    // that admits it.
	    let missed = 0
	    try { missed = JSON.parse(e.data).missed || 0 } catch (_) {}
	    if (missed > 0) addGap(missed)
	  })

	  source.addEventListener('log', function (e) {
	    const ev = JSON.parse(e.data)
	    // The network pane keeps its own paired copy of every network event,
	    // handed over as a DOM event so the two panes stay decoupled. It goes
	    // before the pause check on purpose: Pause is a reading aid for the
	    // logs list, and someone who paused to read still expects the network
	    // table to be current when they switch to it.
	    if ((ev.log || {}).is_network_call) {
	      document.dispatchEvent(new CustomEvent('cs-live-net', { detail: ev }))
	    }
	    if (paused) { queued.push(ev); return }
	    addRow(ev)
	    applyFilter()
	    scrollIfWanted()
	    if (status) status.textContent = 'Streaming'
	  })

	  source.addEventListener('watcher', function (e) {
	    const ev = JSON.parse(e.data)
	    if (!watching) return
	    watching.textContent = ev.watchers === 1 ? '1 watching' : ev.watchers + ' watching'
	  })

	  source.addEventListener('ended', function (e) {
	    endStream(JSON.parse(e.data).reason)
	  })

	  // An error after the server closed us out is the normal end of a stream,
	  // not a failure worth retrying — EventSource would otherwise reconnect
	  // forever to a session that no longer exists.
	  source.addEventListener('error', function () {
	    if (source.readyState === EventSource.CLOSED) endStream('The connection closed.')
	    else if (status) status.textContent = 'Reconnecting…'
	  })
	})()
	</script>
}

// liveNetworkPane is the Network tab of a live session: the same three-phase
// pairing the Network screen does after ingest, done in the browser as the
// phases arrive. One row per request id, updated in place — a call appears the
// moment its request goes out, picks up its status when the response lands,
// and turns red if the error phase arrives instead.
//
// Left the calls, right the inspector, the same split the Network screen uses.
// Below xl they stack, and the inspector renders under the table.
templ liveNetworkPane() {
	<div class="rounded-xl border border-cs-border">
		<div class="flex flex-wrap items-center gap-2 border-b border-cs-border px-4 py-2.5">
			<input
				data-net-filter
				type="text"
				placeholder="Filter by path…"
				class="w-44 rounded-lg border border-cs-border bg-chinese-black px-3 py-1.5 font-mono text-xs text-white placeholder:text-cs-placeholder focus:border-cs-primary focus:outline-none"
			/>
			<div class="flex gap-1.5">
				@liveNetStatusToggle("all", "All", true)
				@liveNetStatusToggle("ok", "2xx–3xx", false)
				@liveNetStatusToggle("bad", "4xx–5xx", false)
				@liveNetStatusToggle("err", "Failed", false)
			</div>
			<label class="ml-auto flex items-center gap-2 text-xs text-cs-muted">
				<input type="checkbox" data-net-autoscroll checked class="accent-cs-primary"/>
				Auto-scroll
			</label>
		</div>
		<div class="grid grid-cols-1 xl:grid-cols-[1fr_420px]">
			<div data-net-list class="h-[520px] overflow-y-auto">
				<p data-net-empty class="px-4 py-6 font-mono text-xs text-cs-muted">Waiting for the app to make a request.</p>
				<table class="w-full border-separate border-spacing-0 font-mono text-xs tabular-nums">
					<tbody data-net-rows></tbody>
				</table>
			</div>
			<div
				data-net-detail
				class="h-[520px] overflow-y-auto border-t border-cs-border px-4 py-3 xl:border-l xl:border-t-0"
			>
				<p class="py-6 text-center font-mono text-xs text-cs-muted">Pick a call to inspect it.</p>
			</div>
		</div>
	</div>
	@liveNetworkScript()
}

templ liveNetStatusToggle(key string, label string, on bool) {
	<button
		type="button"
		data-net-status={ key }
		aria-pressed={ fmt.Sprintf("%t", on) }
		class="rounded-full border border-cs-border px-2.5 py-1 text-xs font-semibold transition-colors aria-pressed:border-transparent aria-pressed:bg-cs-container aria-pressed:text-white text-cs-placeholder hover:text-white"
	>{ label }</button>
}

// liveNetworkScript pairs phases by request id and renders the table and the
// inspector. Everything device-supplied goes through textContent, never
// innerHTML: a URL, a header value or a body is whatever the app sent, and the
// app is not a source we trust with markup.
templ liveNetworkScript() {
	<script>
	(function () {
	  const list = document.querySelector('[data-net-list]')
	  if (!list || list.dataset.wired) return
	  list.dataset.wired = '1'

	  const rows = list.querySelector('[data-net-rows]')
	  const empty = list.querySelector('[data-net-empty]')
	  const detail = document.querySelector('[data-net-detail]')
	  const filter = document.querySelector('[data-net-filter]')
	  const autoscroll = document.querySelector('[data-net-autoscroll]')
	  const countBadge = document.querySelector('[data-live-net-count]')
	  const statusButtons = Array.prototype.slice.call(document.querySelectorAll('[data-net-status]'))

	  // Calls are capped the same way log rows are: a device left streaming
	  // over lunch must not grow the DOM until the tab dies. Oldest evicted
	  // first, map entry and row together, or the map leaks what the DOM freed.
	  const MAX_CALLS = 500
	  const calls = new Map()
	  const order = []

	  let selected = null
	  let statusFilter = 'all'

	  const STATE_CLASSES = {
	    pending: 'text-cs-muted',
	    ok: 'text-cs-success',
	    bad: 'text-cs-warning',
	    err: 'text-cs-error',
	  }

	  function stateOf(call) {
	    if (call.err) return 'err'
	    if (call.res) return call.status >= 400 ? 'bad' : 'ok'
	    return 'pending'
	  }

	  function pathOf(raw) {
	    try {
	      const u = new URL(raw)
	      return u.pathname + u.search
	    } catch (_) {
	      return raw || ''
	    }
	  }

	  function timeOf(iso) {
	    const d = new Date(iso)
	    if (isNaN(d)) return ''
	    const two = function (n) { return String(n).padStart(2, '0') }
	    return two(d.getHours()) + ':' + two(d.getMinutes()) + ':' + two(d.getSeconds()) +
	      '.' + String(d.getMilliseconds()).padStart(3, '0')
	  }

	  function durationOf(call) {
	    if (!call.reqAt || !call.doneAt) return ''
	    const ms = call.doneAt - call.reqAt
	    if (ms < 0) return ''
	    return ms >= 1000 ? (ms / 1000).toFixed(2) + ' s' : ms + ' ms'
	  }

	  function statusText(call) {
	    if (call.err) return 'failed'
	    if (call.res) return String(call.status || '—')
	    return '…'
	  }

	  function cell(className) {
	    const td = document.createElement('td')
	    td.className = className
	    return td
	  }

	  function render(call) {
	    if (!call.row) {
	      const tr = document.createElement('tr')
	      tr.className = 'cursor-pointer border-b border-cs-border hover:bg-cs-container'
	      tr.append(
	        cell('w-24 whitespace-nowrap px-3 py-1.5 text-cs-placeholder'),
	        cell('w-14 px-2 py-1.5 font-semibold text-cs-text'),
	        cell('max-w-0 truncate px-2 py-1.5 text-cs-muted'),
	        cell('w-16 px-2 py-1.5 text-right font-semibold'),
	        cell('w-20 whitespace-nowrap px-3 py-1.5 text-right text-cs-placeholder'),
	      )
	      tr.addEventListener('click', function () { select(call) })
	      call.row = tr
	      rows.appendChild(tr)
	    }
	    const tds = call.row.children
	    tds[0].textContent = timeOf(call.startedAt)
	    tds[1].textContent = call.method || '—'
	    tds[2].textContent = pathOf(call.url)
	    tds[2].title = call.url || ''
	    tds[3].textContent = statusText(call)
	    tds[3].className = 'w-16 px-2 py-1.5 text-right font-semibold ' + STATE_CLASSES[stateOf(call)]
	    tds[4].textContent = durationOf(call)
	    call.row.dataset.netState = stateOf(call)
	    call.row.dataset.netPath = pathOf(call.url).toLowerCase()
	    if (selected === call) {
	      call.row.setAttribute('aria-selected', 'true')
	      call.row.classList.add('bg-cs-container')
	      renderDetail(call)
	    }
	    applyNetFilter()
	  }

	  function section(host, title) {
	    const h = document.createElement('h3')
	    h.className = 'mb-1 mt-4 text-xs font-semibold uppercase tracking-wide text-cs-placeholder first:mt-0'
	    h.textContent = title
	    host.appendChild(h)
	  }

	  function pre(host, value) {
	    const p = document.createElement('pre')
	    p.className = 'overflow-x-auto whitespace-pre-wrap break-words rounded-lg bg-cs-input p-2.5 font-mono text-xs leading-relaxed text-cs-text'
	    p.textContent = typeof value === 'string' ? value : JSON.stringify(value, null, 2)
	    host.appendChild(p)
	  }

	  function kv(host, obj) {
	    const dl = document.createElement('dl')
	    dl.className = 'grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 font-mono text-xs'
	    Object.keys(obj).forEach(function (key) {
	      const dt = document.createElement('dt')
	      dt.className = 'text-cs-placeholder'
	      dt.textContent = key
	      const dd = document.createElement('dd')
	      dd.className = 'break-all text-cs-text'
	      dd.textContent = typeof obj[key] === 'string' ? obj[key] : JSON.stringify(obj[key])
	      dl.append(dt, dd)
	    })
	    host.appendChild(dl)
	  }

	  function renderDetail(call) {
	    detail.textContent = ''

	    const general = {}
	    if (call.method) general['Method'] = call.method
	    if (call.url) general['URL'] = call.url
	    general['Status'] = statusText(call)
	    const dur = durationOf(call)
	    if (dur) general['Duration'] = dur
	    if (call.startedAt) general['Started'] = timeOf(call.startedAt)
	    section(detail, 'General')
	    kv(detail, general)

	    const reqMeta = (call.req && call.req.metadata) || {}
	    if (reqMeta.headers) { section(detail, 'Request headers'); kv(detail, reqMeta.headers) }
	    if (reqMeta.body !== undefined && reqMeta.body !== null) { section(detail, 'Payload'); pre(detail, reqMeta.body) }

	    const resMeta = (call.res && call.res.metadata) || {}
	    if (resMeta.headers) { section(detail, 'Response headers'); kv(detail, resMeta.headers) }
	    if (resMeta.body !== undefined && resMeta.body !== null) { section(detail, 'Response'); pre(detail, resMeta.body) }

	    if (call.err) {
	      const errMeta = call.err.metadata || {}
	      section(detail, 'Error')
	      const facts = {}
	      if (errMeta.type) facts['Type'] = errMeta.type
	      facts['Message'] = errMeta.message || call.err.message || 'The request failed.'
	      kv(detail, facts)
	    }
	  }

	  function select(call) {
	    if (selected && selected.row) {
	      selected.row.removeAttribute('aria-selected')
	      selected.row.classList.remove('bg-cs-container')
	    }
	    selected = call
	    call.row.setAttribute('aria-selected', 'true')
	    call.row.classList.add('bg-cs-container')
	    renderDetail(call)
	  }

	  function clearDetail() {
	    selected = null
	    detail.textContent = ''
	    const p = document.createElement('p')
	    p.className = 'py-6 text-center font-mono text-xs text-cs-muted'
	    p.textContent = 'Pick a call to inspect it.'
	    detail.appendChild(p)
	  }

	  function applyNetFilter() {
	    const needle = (filter && filter.value || '').trim().toLowerCase()
	    Array.prototype.forEach.call(rows.children, function (tr) {
	      const stateHit = statusFilter === 'all' || tr.dataset.netState === statusFilter ||
	        (statusFilter === 'err' && tr.dataset.netState === 'err')
	      const pathHit = !needle || (tr.dataset.netPath || '').indexOf(needle) !== -1
	      tr.hidden = !(stateHit && pathHit)
	    })
	  }

	  function evict() {
	    while (order.length > MAX_CALLS) {
	      const old = order.shift()
	      calls.delete(old.id)
	      if (old.row) old.row.remove()
	      if (selected === old) clearDetail()
	    }
	  }

	  function ingest(ev) {
	    const log = ev.log || {}
	    const id = log.request_id
	    if (!id) return

	    let call = calls.get(id)
	    if (!call) {
	      call = { id: id, method: '', url: '', status: 0, req: null, res: null, err: null,
	        reqAt: null, doneAt: null, startedAt: log.timestamp || ev.at, row: null }
	      calls.set(id, call)
	      order.push(call)
	      evict()
	    }

	    // Any phase may carry the method and URL, and any may arrive first: a
	    // watcher who joined mid-call sees the response before the request it
	    // answers, and the row still has to name what was called.
	    if (log.method) call.method = log.method
	    if (log.url) call.url = log.url

	    const at = Date.parse(log.timestamp || ev.at)
	    if (log.call_phase === 'request') {
	      call.req = log
	      call.reqAt = isNaN(at) ? null : at
	      call.startedAt = log.timestamp || ev.at
	    } else if (log.call_phase === 'response') {
	      call.res = log
	      call.status = log.status_code || 0
	      call.doneAt = isNaN(at) ? null : at
	    } else if (log.call_phase === 'error') {
	      call.err = log
	      call.doneAt = isNaN(at) ? null : at
	    }

	    render(call)
	    if (empty) empty.hidden = true
	    if (countBadge) countBadge.textContent = String(calls.size)
	    if (autoscroll && autoscroll.checked && !selected) list.scrollTop = list.scrollHeight
	  }

	  document.addEventListener('cs-live-net', function (e) { ingest(e.detail) })

	  if (filter) filter.addEventListener('input', applyNetFilter)
	  statusButtons.forEach(function (btn) {
	    btn.addEventListener('click', function () {
	      statusFilter = btn.dataset.netStatus
	      statusButtons.forEach(function (b) {
	        b.setAttribute('aria-pressed', String(b === btn))
	      })
	      applyNetFilter()
	    })
	  })
	})()
	</script>
}
