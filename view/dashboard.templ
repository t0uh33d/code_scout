package view

import (
	"fmt"
	"net"
	"net/url"
	"strings"

	"github.com/google/uuid"
	"github.com/t0uh33d/code_scout/internal/domain"
	"github.com/t0uh33d/code_scout/pkg/utils"
	"github.com/t0uh33d/code_scout/view/static"
)

// The dashboard follows Figma frames 326:1244 (populated) and 326:1394 (empty)
// at a 1440px artboard: a 1320px column with 60px gutters.

// DashboardData holds all data needed to render the dashboard page.
type DashboardData struct {
	Projects *domain.ProjectListResult
	Search   string
	Filter   string // "all" or "favorites"
	User     *domain.User
}

// hasProjects reports whether the page has anything to show. A search that
// returns nothing still counts as having projects, because hiding the search
// box would leave no way to clear the query.
func (d DashboardData) hasProjects() bool {
	return d.Search != "" || (d.Projects != nil && len(d.Projects.Items) > 0)
}

templ Dashboard(data DashboardData) {
	@BaseLayout("Code Scout") {
		<div class="min-h-screen bg-chinese-black">
			@TopNav(data.User)
			<main class="mx-auto max-w-[1440px] px-[60px] pb-20 pt-[60px]">
				<div id="projects-section">
					@ProjectsBody(data)
				</div>
			</main>
			@AddProjectModal()
		</div>
	}
}

// TopNav — a floating rounded bar inset from the page edge, not a full-bleed
// header with a bottom rule.
templ TopNav(user *domain.User) {
	<header class="mx-auto max-w-[1440px] px-[60px] pt-5">
		<nav class="flex h-[82px] items-center justify-between rounded-xl border border-cs-nav-border bg-cs-container px-6">
			<a href="/" class="flex shrink-0 items-center">
				<img src={ static.LOGIN_HEADER_IMAGE } class="h-9 w-auto" alt="Code Scout"/>
			</a>
			<div class="flex items-center gap-10 text-sm tracking-[0.14px]">
				<a href={ templ.SafeURL(static.GITHUB_URL) } target="_blank" rel="noopener" class="font-semibold text-cs-primary transition-opacity hover:opacity-80">GitHub</a>
				<a href={ templ.SafeURL(static.DOCS_URL) } class="text-white transition-opacity hover:opacity-80">Docs</a>
			</div>
			@accountMenu(user)
		</nav>
	</header>
}

// accountMenu is a details/summary disclosure rather than a JS dropdown: the
// browser gives open/close, Escape and click-to-toggle for free.
templ accountMenu(user *domain.User) {
	<details class="relative" id="account-menu">
		<summary class="flex size-10 cursor-pointer list-none items-center justify-center rounded-full border-[1.25px] border-cs-avatar-border bg-gradient-to-br from-blue-500 to-indigo-600 marker:hidden">
			<span class="select-none text-sm font-bold text-white">{ initial(user) }</span>
		</summary>
		<div class="absolute right-0 top-[calc(100%+8px)] z-50 w-64 overflow-hidden rounded-xl border border-cs-border bg-cs-container shadow-2xl">
			@accountMenuItems(user, true)
		</div>
	</details>
	@accountMenuScript()
}

// accountMenuItems is the menu body, shared by the top nav's avatar dropdown and
// the project sidebar's. Only the anchoring and the header differ: the sidebar
// trigger already shows the name and email, so repeating them right above it
// would say the same thing twice.
templ accountMenuItems(user *domain.User, showIdentity bool) {
	if showIdentity {
		<div class="border-b border-cs-border px-4 py-3">
			if user != nil {
				<p class="truncate text-sm font-semibold text-white">{ user.Name }</p>
				<p class="truncate text-xs text-cs-muted">{ user.Email }</p>
			} else {
				<p class="text-sm font-semibold text-white">Signed in</p>
			}
		</div>
	}
	<a
		href="/settings"
		class="flex w-full items-center gap-2 px-4 py-3 text-left text-sm text-cs-muted no-underline transition-colors hover:bg-cs-card hover:text-white"
	>
		<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
		Settings
	</a>
	<a
		href="/change-password"
		class="flex w-full items-center gap-2 px-4 py-3 text-left text-sm text-cs-muted no-underline transition-colors hover:bg-cs-card hover:text-white"
	>
		<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
		Change password
	</a>
	<form method="POST" action="/api/auth/logout">
		<button
			type="submit"
			class="flex w-full items-center gap-2 px-4 py-3 text-left text-sm text-cs-muted transition-colors hover:bg-cs-card hover:text-white"
		>
			<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" x2="9" y1="12" y2="12"/></svg>
			Log out
		</button>
	</form>
}

// accountMenuScript closes the menu on an outside click, which <details> does
// not do on its own. Both menus carry the same id and only one is ever on a
// page, so a single handler serves them.
templ accountMenuScript() {
	<script>
		document.addEventListener('click', function (e) {
			var menu = document.getElementById('account-menu');
			if (menu && menu.open && !menu.contains(e.target)) menu.open = false;
		});
	</script>
}

// initial is the avatar letter. Falls back to "U" when the name is missing so
// the circle is never empty.
func initial(user *domain.User) string {
	if user == nil {
		return "U"
	}
	for _, r := range user.Name {
		return upperFirst(r)
	}
	for _, r := range user.Email {
		return upperFirst(r)
	}
	return "U"
}

func upperFirst(r rune) string { return strings.ToUpper(string(r)) }

// ProjectsBody is the whole page below the nav. On a first run with no
// projects the design drops the title and toolbar entirely and shows only the
// centred empty state, so the branch lives here rather than inside the grid.
templ ProjectsBody(data DashboardData) {
	if data.hasProjects() {
		<div class="flex flex-col gap-8">
			<h1 class="text-2xl font-bold tracking-[0.24px] text-cs-text">{ static.PROJECTS_TITLE }</h1>
			@ProjectsList(data)
		</div>
	} else {
		@EmptyProjects()
	}
}

// ProjectsSectionOOB is the same body wrapped for an out-of-band swap. HTMX
// lifts any element carrying hx-swap-oob out of a response and applies it to the
// matching id anywhere on the page, independent of hx-target. That lets one
// response drive the modal and refresh the list behind it at the same time.
templ ProjectsSectionOOB(data DashboardData) {
	<div id="projects-section" hx-swap-oob="true">
		@ProjectsBody(data)
	</div>
}

// ProjectsList is the toolbar plus the grid. Switching tabs replaces the whole
// thing, because the active tab and the hidden filter both have to change.
// Typing in the search box replaces only the grid inside it, so the input keeps
// focus between keystrokes.
templ ProjectsList(data DashboardData) {
	<div id="projects-list" class="flex flex-col gap-6">
		@projectsToolbar(data)
		@ProjectGrid(data.Projects, data.Filter, data.Search)
	</div>
}

templ projectsToolbar(data DashboardData) {
	<div class="flex items-center justify-between gap-4">
		<!-- Segmented control: one bordered container holding both tabs -->
		<div class="flex shrink-0 items-center gap-2 rounded-lg border border-cs-border bg-cs-container p-2">
			@filterTab(static.ALL_PROJECTS, data.Filter != "favorites", "all")
			@filterTab(static.FAV_PROJECTS, data.Filter == "favorites", "favorites")
		</div>
		<div class="flex min-w-0 flex-1 items-center justify-end gap-6">
			<div class="relative h-10 w-[323px] shrink-0">
				<span class="pointer-events-none absolute left-3 top-1/2 flex size-5 -translate-y-1/2 items-center justify-center text-cs-placeholder">
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
				</span>
				<!-- Travels with every search so filtering does not reset the tab. -->
				<input type="hidden" name="filter" value={ data.Filter }/>
				<input
					type="text"
					name="search"
					placeholder={ static.SEARCH_LABEL }
					value={ data.Search }
					hx-get="/dashboard/projects"
					hx-trigger="keyup changed delay:300ms, search"
					hx-target="#projects-grid"
					hx-swap="outerHTML"
					hx-include="previous input[name='filter']"
					class="h-10 w-full rounded-md border-[0.5px] border-cs-border bg-cs-input pl-9 pr-3 text-sm font-light text-white transition-colors placeholder:text-cs-placeholder focus:border-cs-primary focus:outline-none"
				/>
			</div>
			@addProjectButton(static.ADD_PROJECT)
		</div>
	</div>
}

// filterTab reads the search box at CLICK time via hx-include rather than
// baking its value into the URL: searching only re-renders the grid, so a URL
// baked here would carry whatever the box held when the toolbar last rendered.
templ filterTab(label string, active bool, filter string) {
	if active {
		<span class="rounded bg-cs-primary px-4 py-[9px] text-xs font-semibold text-white">{ label }</span>
	} else {
		<button
			hx-get={ fmt.Sprintf("/dashboard/projects/list?filter=%s", filter) }
			hx-include="#projects-list input[name='search']"
			hx-target="#projects-list"
			hx-swap="outerHTML"
			class="rounded bg-cs-card px-4 py-[9px] text-xs text-cs-text transition-opacity hover:opacity-80"
		>{ label }</button>
	}
}

// addProjectButton is used both in the toolbar and in the empty state, where
// only the label differs.
// addProjectButton fetches a fresh step 1 and opens the modal only once it has
// arrived. Opening synchronously would flash whatever the wizard last held,
// which after a create is the previous project's plaintext secret.
templ addProjectButton(label string) {
	<button
		hx-get="/dashboard/projects/new"
		hx-target="#project-wizard"
		hx-swap="innerHTML"
		hx-disabled-elt="this"
		hx-on::after-request="if(event.detail.successful) openProjectSheet()"
		class="flex h-10 shrink-0 items-center gap-1.5 rounded-lg bg-cs-primary px-4 font-display text-xs font-semibold text-cs-btn-text transition-colors hover:bg-blue-600 disabled:opacity-60"
	>
		<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="M5 12h14"/></svg>
		{ label }
	</button>
}

// EmptyProjects — Figma 326:1410.
templ EmptyProjects() {
	<div class="flex flex-col items-center gap-[25px] pt-[84px]">
		<div class="flex w-[370px] flex-col items-center gap-px">
			<img src="/static/images/empty_projects.png" class="h-[222px] w-[193.529px]" alt="Pim has not found any projects"/>
			<div class="flex w-full flex-col gap-2 text-center">
				<p class="text-lg font-bold tracking-[0.18px] text-white">No projects yet!</p>
				<p class="text-sm tracking-[0.14px] text-cs-muted">Start by creating your first project to get things moving.</p>
			</div>
		</div>
		@addProjectButton("Add a new project")
	</div>
}

templ credentialRow(label string, value string) {
	<div class="flex flex-col gap-[6px]">
		<label class="text-xs font-medium uppercase tracking-wider text-cs-muted">{ label }</label>
		<div class="flex items-center gap-2">
			<input
				readonly
				value={ value }
				onclick="this.select()"
				class="w-full rounded-lg border border-cs-input-border bg-cs-input px-4 py-2.5 font-mono text-sm text-white transition-colors focus:border-cs-primary focus:outline-none"
			/>
			<button
				type="button"
				onclick="navigator.clipboard.writeText(this.previousElementSibling.value);this.textContent='Copied'"
				class="shrink-0 rounded-lg border border-cs-border bg-cs-card px-4 py-2.5 text-sm font-semibold text-cs-muted transition-colors hover:text-white"
			>Copy</button>
		</div>
	</div>
}

// ProjectGrid — three columns of cards at the 1320px artboard width.
templ ProjectGrid(result *domain.ProjectListResult, filter string, search string) {
	<div id="projects-grid">
		if result != nil && len(result.Items) > 0 {
			<div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
				for _, item := range result.Items {
					@ProjectCard(item)
				}
			</div>
			if result.TotalPages > 1 {
				@Pagination(result.Page, result.TotalPages, filter, search)
			}
		} else if search != "" {
			<!-- Checked before the favourites branch: a search miss inside the
			     favourites tab is a search miss, not an empty favourites list. -->
			<div class="flex flex-col items-center gap-2 py-20 text-center">
				<p class="text-lg font-bold tracking-[0.18px] text-white">Nothing matches "{ search }"</p>
				<p class="text-sm tracking-[0.14px] text-cs-muted">Try a shorter search, or clear it to see every project.</p>
			</div>
		} else if filter == "favorites" {
			<div class="flex flex-col items-center gap-2 py-20 text-center">
				<p class="text-lg font-bold tracking-[0.18px] text-white">No favourites yet</p>
				<p class="text-sm tracking-[0.14px] text-cs-muted">Star a project from the All projects tab to pin it here.</p>
			</div>
		} else {
			@EmptyProjects()
		}
	</div>
}

// ProjectCard — Figma 326:1421 for the shell and typography, plus the activity
// block from the prototype: a 24h sparkline with log and error counts, which is
// what makes a card worth scanning rather than just a link.
// ProjectCard is a div, not an anchor, so the star can be a real button. The
// title carries a stretched link instead: its ::after covers the whole card, so
// the card is still one big click target, and the star sits above it.
templ ProjectCard(item domain.ProjectListItem) {
	<div class="relative flex flex-col rounded-xl border border-cs-card bg-cs-card px-6 py-4 transition-colors hover:border-cs-border">
		<div class="flex items-start gap-[13px]">
			<div class="flex min-w-0 flex-1 flex-col gap-3">
				<a
					href={ templ.SafeURL(fmt.Sprintf("/project/%s/overview", item.ID)) }
					class="truncate text-lg font-bold tracking-[0.18px] text-white no-underline after:absolute after:inset-0 after:content-['']"
				>{ item.Name }</a>
				<p class="truncate font-mono text-sm tracking-[0.14px] text-cs-muted">{ item.ID.String() }</p>
			</div>
			@FavoriteStar(item.ID, item.IsFavorite)
		</div>
		<!-- Fetched only once the card scrolls into view, so a long list does not
		     fire one stats query per project up front. -->
		<div
			hx-get={ fmt.Sprintf("/project/%s/stats", item.ID) }
			hx-trigger="revealed"
			hx-swap="innerHTML"
			class="mt-4 min-h-[46px]"
		></div>
	</div>
}

// FavoriteStar is both the control and the response to pressing it: the handler
// re-renders this one element, so the button swaps itself.
templ FavoriteStar(projectID uuid.UUID, isFavorite bool) {
	<button
		type="button"
		hx-post={ fmt.Sprintf("/project/%s/favorite", projectID) }
		hx-target="this"
		hx-swap="outerHTML"
		class={ "relative z-10 shrink-0 transition-colors", templ.KV("text-cs-primary", isFavorite), templ.KV("text-cs-star hover:text-white", !isFavorite) }
		aria-pressed={ fmt.Sprintf("%t", isFavorite) }
		if isFavorite {
			aria-label="Remove from favourites"
		} else {
			aria-label="Add to favourites"
		}
	>
		if isFavorite {
			<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
		} else {
			<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
		}
	</button>
}

// shortID renders a UUID the way the prototype does: enough to recognise, not
// enough to read as noise. The full value stays in the title attribute.
// pageURL keeps the active tab and search query on every page link, so paging
// inside a filtered list stays inside it.
func pageURL(page int, filter string, search string) string {
	return fmt.Sprintf("/dashboard/projects?page=%d&filter=%s&search=%s",
		page, url.QueryEscape(filter), url.QueryEscape(search))
}

// Pagination — Figma 326:1295. 32px squares, 4px apart, right aligned. The 4px
// vertical padding is what puts the cells 36px below the grid, not 32px.
templ Pagination(currentPage int, totalPages int, filter string, search string) {
	<div class="mt-8 flex items-center justify-end gap-1 py-1">
		if currentPage > 1 {
			<button
				hx-get={ pageURL(currentPage-1, filter, search) }
				hx-target="#projects-grid"
				hx-swap="outerHTML"
				class="flex size-8 items-center justify-center rounded bg-cs-pager text-cs-btn-text transition-colors hover:bg-cs-primary"
				aria-label="Previous page"
			>
				@chevron("m15 18-6-6 6-6")
			</button>
		} else {
			<span class="flex size-8 cursor-not-allowed items-center justify-center rounded bg-cs-pager text-cs-btn-text opacity-40">
				@chevron("m15 18-6-6 6-6")
			</span>
		}
		for i := 1; i <= totalPages; i++ {
			if i == currentPage {
				<span class="flex size-8 items-center justify-center rounded bg-cs-primary font-display text-sm font-medium text-cs-btn-text">
					{ fmt.Sprintf("%d", i) }
				</span>
			} else if i == 1 || i == totalPages || (i >= currentPage-1 && i <= currentPage+1) {
				<button
					hx-get={ pageURL(i, filter, search) }
					hx-target="#projects-grid"
					hx-swap="outerHTML"
					class="flex size-8 items-center justify-center rounded font-display text-sm text-cs-muted transition-colors hover:text-white"
				>
					{ fmt.Sprintf("%d", i) }
				</button>
			} else if (i == 2 && currentPage > 4) || (i == totalPages-1 && currentPage < totalPages-3) {
				<span class="flex size-8 items-center justify-center" aria-hidden="true">
					<span class="flex w-4 items-center gap-[2px]">
						<span class="size-1 rounded-full bg-cs-muted"></span>
						<span class="size-1 rounded-full bg-cs-muted"></span>
						<span class="size-1 rounded-full bg-cs-muted"></span>
					</span>
				</span>
			}
		}
		if currentPage < totalPages {
			<button
				hx-get={ pageURL(currentPage+1, filter, search) }
				hx-target="#projects-grid"
				hx-swap="outerHTML"
				class="flex size-8 items-center justify-center rounded bg-cs-pager text-cs-btn-text transition-colors hover:bg-cs-primary"
				aria-label="Next page"
			>
				@chevron("m9 18 6-6-6-6")
			</button>
		} else {
			<span class="flex size-8 cursor-not-allowed items-center justify-center rounded bg-cs-pager text-cs-btn-text opacity-40">
				@chevron("m9 18 6-6-6-6")
			</span>
		}
	</div>
}

templ chevron(d string) {
	<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={ d }/></svg>
}

// WizardDraft carries step 1's answers forward. The project is not created
// until the last form is submitted, so backing out of the Access step leaves no
// half-made project behind.
type WizardDraft struct {
	Name        string
	Description string
	Errors      []utils.FieldError
	// Candidates are the accounts the Access step can offer. Empty on a solo
	// instance, which is what collapses the wizard back to two steps.
	Candidates []domain.User
}

func (d WizardDraft) hasAccessStep() bool { return len(d.Candidates) > 0 }

// stepLabels is the rail. An Access step nobody could fill in is a dead click,
// so a one-account instance never sees it.
func stepLabels(hasAccessStep bool) []string {
	if hasAccessStep {
		return []string{"Project details", "Who can see it", "Connect your app"}
	}
	return []string{"Project details", "Connect your app"}
}

// AddProjectModal is only the shell. The body is fetched and replaced by the
// server as the wizard advances, so no step state lives in the browser.
//
// A side sheet rather than a centred dialog: the last step carries credentials
// and a copy-paste snippet, which a full-height panel fits without scrolling.
templ AddProjectModal() {
	<div id="add-project-modal" class="fixed inset-0 z-50 hidden">
		<div
			id="sheet-overlay"
			onclick="closeProjectSheet()"
			class="absolute inset-0 bg-[#0A0E11]/50 opacity-0 backdrop-blur-[12px] transition-opacity duration-200 motion-reduce:transition-none"
		></div>
		<!-- translate-x-full is removed a frame after unhiding, which is what
		     makes the sheet slide rather than appear. -->
		<aside
			id="project-sheet"
			role="dialog"
			aria-modal="true"
			aria-label="New project"
			class="absolute bottom-4 right-4 top-4 flex w-[440px] max-w-[calc(100%-2rem)] translate-x-[calc(100%+1rem)] flex-col overflow-hidden rounded-2xl border border-cs-border bg-cs-container shadow-2xl transition-transform duration-200 ease-out motion-reduce:transition-none"
		>
			<!-- Empty on purpose: the button fetches step 1 into here before it
			     opens the sheet, so the page never ships a stale wizard. -->
			<div id="project-wizard" class="flex min-h-0 flex-1 flex-col"></div>
		</aside>
	</div>
	<script>
		function openProjectSheet() {
			var m = document.getElementById('add-project-modal');
			m.classList.remove('hidden');
			// Next frame, so the browser has a start state to animate from.
			requestAnimationFrame(function () {
				document.getElementById('project-sheet').classList.remove('translate-x-[calc(100%+1rem)]');
				document.getElementById('sheet-overlay').classList.remove('opacity-0');
			});
		}
		function closeProjectSheet() {
			var m = document.getElementById('add-project-modal');
			document.getElementById('project-sheet').classList.add('translate-x-[calc(100%+1rem)]');
			document.getElementById('sheet-overlay').classList.add('opacity-0');
			setTimeout(function () { m.classList.add('hidden'); }, 200);
		}
		document.addEventListener('keydown', function (e) {
			var m = document.getElementById('add-project-modal');
			if (e.key === 'Escape' && m && !m.classList.contains('hidden')) closeProjectSheet();
		});
	</script>
}

// wizardHeader is the sheet's fixed top: title, close, and the step rail. At
// 440px the rail carries numbers and a progress bar rather than step labels,
// which would not fit.
templ wizardHeader(steps []string, current int) {
	<div class="shrink-0 px-6 pb-4 pt-6">
		<div class="flex items-center gap-4">
			<h2 class="flex-1 text-lg font-bold tracking-[0.18px] text-white">New project</h2>
			<button
				type="button"
				onclick="closeProjectSheet()"
				class="flex size-[26px] shrink-0 items-center justify-center rounded text-cs-muted transition-colors hover:text-white"
				aria-label="Close"
			>
				<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
			</button>
		</div>
		<div class="mt-4 flex items-center gap-2">
			for i, label := range steps {
				<div class="flex flex-1 flex-col gap-1.5">
					<span class={ "h-[3px] rounded-full", templ.KV("bg-cs-primary", i <= current), templ.KV("bg-cs-border", i > current) }></span>
					<span class={ "text-[11px] font-medium", templ.KV("text-white", i == current), templ.KV("text-cs-muted", i != current) }>
						{ fmt.Sprintf("%d. %s", i+1, label) }
					</span>
				</div>
			}
		</div>
	</div>
}

// sheetBody scrolls; sheetFooter stays pinned to the bottom of the sheet.
templ sheetFooter() {
	<div class="shrink-0 border-t border-cs-border px-6 py-4">
		{ children... }
	</div>
}

// WizardDetails — step 1. Where it posts depends on whether there is anyone to
// add: with teammates it goes to the Access step, alone it creates the project
// outright. Either way nothing is written until the last form is submitted.
templ WizardDetails(d WizardDraft) {
	{{ nameErr := fieldErrorFor(d.Errors, "name") }}
	@wizardHeader(stepLabels(d.hasAccessStep()), 0)
	<!-- hx-disabled-elt disables the submit button while the request is in
	     flight, so a double click cannot create the project twice. -->
	<form
		if d.hasAccessStep() {
			hx-post="/dashboard/projects/access"
		} else {
			hx-post="/dashboard/projects"
		}
		hx-target="#project-wizard"
		hx-swap="innerHTML"
		hx-disabled-elt="find button[type='submit']"
		class="flex min-h-0 flex-1 flex-col"
	>
		<div class="flex min-h-0 flex-1 flex-col gap-6 overflow-y-auto px-6 py-2">
			<div class="flex flex-col gap-2">
				<label for="project-name" class="font-display text-xs font-semibold text-white">{ static.PROJECT_NAME }</label>
				<input
					id="project-name"
					name="name"
					type="text"
					placeholder="Enter the project name"
					value={ d.Name }
					required
					autofocus
					class={ "w-full rounded-md border bg-cs-card p-3 text-sm text-white transition-colors placeholder:text-cs-placeholder focus:outline-none",
						templ.KV("border-cs-danger", nameErr != ""),
						templ.KV("border-cs-border focus:border-cs-primary", nameErr == "") }
				/>
				@fieldError(nameErr)
			</div>
			<div class="flex flex-col gap-2">
				<label for="project-desc" class="font-display text-xs font-semibold text-white">{ static.PROJECT_DESC }</label>
				<textarea
					id="project-desc"
					name="description"
					placeholder="What is this app, and which environment is it?"
					rows="4"
					class="h-24 w-full resize-none rounded-md border border-cs-border bg-cs-card p-3 text-sm text-white transition-colors placeholder:text-cs-placeholder focus:border-cs-primary focus:outline-none"
				>{ d.Description }</textarea>
			</div>
		</div>
		@sheetFooter() {
			<div class="flex justify-end gap-3">
				<button
					type="button"
					onclick="closeProjectSheet()"
					class="rounded-lg border border-cs-border bg-cs-card px-5 py-2 text-sm text-cs-muted transition-colors hover:text-white"
				>Cancel</button>
				<button
					type="submit"
					class="flex items-center gap-2 rounded-lg bg-cs-primary px-5 py-2 font-display text-sm font-semibold text-cs-btn-text transition-colors hover:bg-blue-600"
				>
					if d.hasAccessStep() {
						Next
					} else {
						Create project
					}
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
				</button>
			</div>
		}
	</form>
}

// WizardAccess — step 2, and the step that actually creates the project. Step
// 1's answers ride along as hidden inputs, so this one form carries everything
// and the project is written once, with its members, in a single transaction.
templ WizardAccess(d WizardDraft) {
	@wizardHeader(stepLabels(true), 1)
	<form
		hx-post="/dashboard/projects"
		hx-target="#project-wizard"
		hx-swap="innerHTML"
		hx-disabled-elt="find button[type='submit']"
		class="flex min-h-0 flex-1 flex-col"
	>
		<input type="hidden" name="name" value={ d.Name }/>
		<input type="hidden" name="description" value={ d.Description }/>
		<div class="flex min-h-0 flex-1 flex-col gap-4 overflow-y-auto px-6 py-2">
			<p class="text-sm text-cs-muted">
				You are this project's maintainer. Super admins already see every
				project. Anyone else has to be added, here or later in Settings.
			</p>
			<div class="flex flex-col">
				for _, c := range d.Candidates {
					@candidateRow(c)
				}
			</div>
		</div>
		@sheetFooter() {
			<div class="flex justify-between gap-3">
				<!-- Back re-renders step 1 from the values in this form, so the
				     name and description survive the trip. hx-include picks them
				     up from the hidden inputs above. -->
				<button
					type="button"
					hx-post="/dashboard/projects/new"
					hx-include="closest form"
					hx-target="#project-wizard"
					hx-swap="innerHTML"
					class="rounded-lg border border-cs-border bg-cs-card px-5 py-2 text-sm text-cs-muted transition-colors hover:text-white"
				>Back</button>
				<button
					type="submit"
					class="flex items-center gap-2 rounded-lg bg-cs-primary px-5 py-2 font-display text-sm font-semibold text-cs-btn-text transition-colors hover:bg-blue-600"
				>
					Create project
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
				</button>
			</div>
		}
	</form>
}

// candidateRow is one account: a checkbox that decides whether they are added
// at all, and a level that only matters if it is ticked. The level field is
// named after the account so the server can pair the two without positional
// guessing.
templ candidateRow(c domain.User) {
	<label class="flex cursor-pointer items-center gap-3 border-b border-cs-border py-3 last:border-b-0">
		<input
			type="checkbox"
			name="member"
			value={ c.ID.String() }
			class="size-4 shrink-0 accent-cs-primary"
		/>
		<span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-blue-500 to-indigo-600 text-xs font-bold text-white">
			{ initialOf(c.Name, c.Email) }
		</span>
		<span class="min-w-0 flex-1">
			<span class="block truncate text-sm font-semibold text-white">{ c.Name }</span>
			<span class="block truncate font-mono text-xs text-cs-muted">{ c.Email }</span>
		</span>
		<select
			name={ "level_" + c.ID.String() }
			onclick="event.stopPropagation()"
			class="shrink-0 rounded-lg border border-cs-border bg-chinese-black px-2 py-1 text-xs text-white focus:border-cs-primary focus:outline-none"
		>
			<option value="viewer">Viewer</option>
			<option value="maintainer">Maintainer</option>
		</select>
	</label>
}

// WizardConnect — the last step. The plaintext secret exists only in this
// response, so the step is deliberately a handoff: copy it, or lose it.
templ WizardConnect(d *domain.ProjectDetails, baseURL string, hadAccessStep bool) {
	{{ steps := stepLabels(hadAccessStep) }}
	@wizardHeader(steps, len(steps)-1)
	<div class="flex min-h-0 flex-1 flex-col gap-5 overflow-y-auto px-6 py-2">
		<div>
			<h3 class="text-base font-semibold text-white">{ d.Name } is ready</h3>
			<p class="mt-1 text-sm text-cs-muted">Copy these into your Flutter app now. The secret key is never shown again.</p>
		</div>
		@credentialRow("Project ID", d.ID.String())
		@credentialRow("Secret key", d.SecretKey)
		<div class="flex flex-col gap-[6px]">
			<span class="text-xs font-medium uppercase tracking-wider text-cs-muted">Add this to your app</span>
			<div class="relative">
				<pre id="setup-snippet" class="overflow-x-auto rounded-lg border border-cs-border bg-chinese-black p-4 font-mono text-xs leading-relaxed text-cs-text">{ setupSnippet(d, baseURL) }</pre>
				<button
					type="button"
					onclick="navigator.clipboard.writeText(document.getElementById('setup-snippet').textContent);this.textContent='Copied'"
					class="absolute right-3 top-3 rounded-md border border-cs-border bg-cs-card px-3 py-1 text-xs font-semibold text-cs-muted transition-colors hover:text-white"
				>Copy</button>
			</div>
			if isLoopbackURL(baseURL) {
				<p class="mt-1 text-xs leading-relaxed text-amber-400/90">
					This address only works for a simulator on this machine. A real
					device needs your machine's LAN address or a public URL. Open the
					dashboard on that address and this snippet follows, or set
					<span class="font-mono">CS_PUBLIC_BASE_URL</span> to pin it.
				</p>
			}
		</div>
	</div>
	@sheetFooter() {
		<div class="flex justify-end">
			<button
				type="button"
				onclick="closeProjectSheet()"
				class="rounded-lg bg-cs-primary px-5 py-2 font-display text-sm font-semibold text-cs-btn-text transition-colors hover:bg-blue-600"
			>Done</button>
		</div>
	}
}

// isLoopbackURL reports whether the snippet is about to hand a developer an
// address that resolves to the phone itself rather than to this server.
func isLoopbackURL(baseURL string) bool {
	u, err := url.Parse(baseURL)
	if err != nil {
		return false
	}
	// Hostname strips the port and the brackets around an IPv6 literal, which
	// splitting on ":" by hand does not. Lower-cased because DNS names are
	// case-insensitive and the Host header arrives however the user typed it.
	host := strings.ToLower(u.Hostname())
	if host == "localhost" {
		return true
	}
	if ip := net.ParseIP(host); ip != nil {
		return ip.IsLoopback() || ip.IsUnspecified()
	}
	return false
}

func setupSnippet(d *domain.ProjectDetails, baseURL string) string {
	return fmt.Sprintf(`await CodeScout.instance.init(
  freshContextFetcher: () => context,
  configuration: CodeScoutConfiguration(
    logging: LoggingBehavior(minimumLevel: LogLevel.all),
    projectCredentials: ProjectCredentials(
      link: '%s/',
      projectID: '%s',
      projectSecret: '%s',
    ),
  ),
);`, baseURL, d.ID.String(), d.SecretKey)
}
