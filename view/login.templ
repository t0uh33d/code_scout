package view 

templ Login() {
    @BaseLayout("Login") {
        <div class="min-h-screen flex justify-center items-center">
            <div class="w-full max-w-[440px] flex flex-col items-center">
                <img src="/static/images/login_header.svg" class="h-auto w-[330px] mb-6" alt="Login Header"/>
                <div class="border border-eerie-black rounded-2xl p-10 h-[100px] w-full">
                </div>
            </div>
        </div>
    }
}