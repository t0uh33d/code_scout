package view

import (
	"fmt"
	"github.com/google/uuid"
	"github.com/t0uh33d/code_scout/internal/domain"
)

type SessionTimelineData struct {
	ProjectID uuid.UUID
	SessionID uuid.UUID
	Logs      []domain.Log
}

templ SessionTimelinePage(data SessionTimelineData) {
	@BaseLayout("Code Scout — Session Timeline") {
		<div class="min-h-screen bg-chinese-black">
			@TopNav()
			<div class="max-w-[1280px] mx-auto px-6 py-6">
				<!-- Breadcrumb -->
				<a
					href={ templ.SafeURL(fmt.Sprintf("/project/%s/logs", data.ProjectID)) }
					class="text-cs-muted hover:text-white text-sm transition-colors mb-4 inline-flex items-center gap-1"
				>
					<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
					Back to Logs
				</a>

				<!-- Session Header -->
				<div class="mt-2 mb-6">
					<h1 class="text-xl font-bold text-white">Session Timeline</h1>
					<p class="text-cs-muted text-sm font-mono mt-1">{ data.SessionID.String() }</p>
					<p class="text-cs-muted text-xs mt-1">{ fmt.Sprintf("%d events", len(data.Logs)) }</p>
				</div>

				<!-- Timeline -->
				if len(data.Logs) > 0 {
					<div class="relative pl-8">
						<!-- Vertical line -->
						<div class="absolute left-[11px] top-0 bottom-0 w-[2px] bg-cs-border"></div>

						for _, log := range data.Logs {
							@TimelineEvent(log, data.ProjectID)
						}
					</div>
				} else {
					<div class="flex flex-col items-center justify-center py-20 text-center">
						<p class="text-cs-muted text-sm">No events in this session.</p>
						<a
							href={ templ.SafeURL(fmt.Sprintf("/project/%s/logs", data.ProjectID)) }
							class="text-cs-primary text-sm mt-2 hover:underline"
						>
							Back to logs
						</a>
					</div>
				}
			</div>
		</div>
	}
}

templ TimelineEvent(log domain.Log, projectID uuid.UUID) {
	<div class="relative flex items-start gap-4 mb-4">
		<!-- Node -->
		if log.IsNetworkCall {
			<!-- Diamond for network calls -->
			<div class="absolute left-[-25px] top-1 w-3 h-3 rotate-45 bg-cs-primary border-2 border-chinese-black z-10"></div>
		} else if log.Level == "error" || log.Level == "fatal" {
			<!-- Filled circle for errors -->
			<div class="absolute left-[-27px] top-1 w-3.5 h-3.5 rounded-full bg-[#F85149] border-2 border-chinese-black z-10"></div>
		} else {
			<!-- Regular circle -->
			<div class="absolute left-[-27px] top-1.5 w-3 h-3 rounded-full bg-cs-border border-2 border-chinese-black z-10"></div>
		}

		<!-- Content -->
		<div class="flex-1 bg-cs-card border border-cs-border rounded-lg p-4 hover:border-cs-muted/40 transition-colors">
			<div class="flex items-center gap-3 mb-1">
				<span class="font-mono text-[11px] text-cs-muted tabular-nums">
					{ log.TimeStamp.Format("15:04:05.000") }
				</span>
				@LogLevelBadge(log.Level)
				if log.IsNetworkCall && log.CallPhase != nil {
					<span class="text-[10px] text-cs-muted uppercase font-semibold tracking-wider">
						{ string(*log.CallPhase) }
					</span>
				}
			</div>
			<p class="text-sm text-cs-muted">{ log.Message }</p>

			if log.Error != nil && *log.Error != "" {
				<pre class="font-mono text-xs text-red-400 mt-2 whitespace-pre-wrap">{ *log.Error }</pre>
			}

			<!-- Links -->
			if log.IsNetworkCall && log.RequestID != nil {
				<a
					href={ templ.SafeURL(fmt.Sprintf("/project/%s/network/%s", projectID, log.RequestID)) }
					class="text-cs-primary text-xs font-mono hover:underline mt-2 inline-block"
				>
					View network detail →
				</a>
			}
		</div>
	</div>
}
