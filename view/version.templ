package view

import (
	"fmt"

	"github.com/getcodescout/code_scout/app"
	"github.com/getcodescout/code_scout/internal/domain"
)

// buildDetail is what hovering the version shows: the commit and when it was
// built. Both are "-" on a plain `go build`, and saying so is more useful than
// hiding the line, because "I built this myself" is a real answer to "what are
// you running".
func buildDetail() string {
	return fmt.Sprintf("Code Scout %s\nCommit %s\nBuilt %s", app.Version, app.Commit, app.BuildTime)
}

// showUpdateBadge decides whether this viewer sees the nudge.
//
// Only super admins, because upgrading is an operation on the server itself.
// Telling a viewer their dashboard is out of date gives them a worry and no
// action, and a notice that cannot be acted on is trained out of within a week.
func showUpdateBadge(user *domain.User) bool {
	return user != nil && user.Role == domain.RoleSuperAdmin && UpdateState().Behind
}

// sdkVersionCell renders the SDK version a session reported.
//
// Nil means the app is running a release from before the SDK started sending
// it, which is worth showing as its own thing rather than as blank: "older than
// 1.4.0" is real information, and an empty cell reads as a rendering bug.
//
// It deliberately does not mark a version as out of date. The dashboard knows
// what the newest *dashboard* release is, because it asks GitHub about its own
// repository; it has no idea what the newest SDK on pub.dev is, and guessing
// from its own version number would be wrong the first time the two are
// released apart.
templ sdkVersionCell(version *string) {
	if version != nil {
		<span class="font-mono text-xs text-cs-muted">{ *version }</span>
	} else {
		<span title="Sent by an SDK from before it reported its version" class="font-mono text-xs text-cs-placeholder">&mdash;</span>
	}
}

// versionTag is the build identity as it appears in the chrome: the foot of the
// project sidebar, and the top nav on the screens that have no sidebar.
//
// The version is plain text rather than a link. It is an identifier, and a
// permanent link to a releases page that most people never want costs a
// tab-stop on every screen. The badge beside it, when there is one, is the
// link, because at that point there is something to go and read.
//
// Padding is the caller's, since the two places it sits align to different
// things.
templ versionTag(user *domain.User) {
	<div class="flex shrink-0 items-center gap-2">
		<span title={ buildDetail() } class="font-mono text-[10px] text-cs-placeholder">
			v{ app.Version }
		</span>
		if showUpdateBadge(user) {
			<a
				href={ templ.SafeURL(UpdateState().URL) }
				target="_blank"
				rel="noopener noreferrer"
				title={ fmt.Sprintf("Version %s is available", UpdateState().Latest) }
				class="inline-flex items-center gap-1 rounded-full bg-cs-primary/15 px-1.5 py-0.5 text-[10px] font-medium text-cs-primary transition-colors hover:bg-cs-primary/25"
			>
				<span class="size-1 rounded-full bg-cs-primary"></span>
				{ UpdateState().Latest }
			</a>
		}
	</div>
}
