# Local development settings. Copy to .env and adjust:
#
#   cp .env.example .env
#
# .env is gitignored and loaded automatically by the Makefile, so local
# development needs no /etc/code-scout.conf.

CS_MYSQL_HOST=127.0.0.1
CS_MYSQL_PORT=3306
CS_MYSQL_USER=code_scout
CS_MYSQL_PASSWORD=code_scout
CS_MYSQL_DATABASE=code_scout

CS_HOST=localhost
CS_PORT=24275
