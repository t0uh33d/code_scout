# Local development settings. Copy to .env and adjust:
#
#   cp .env.example .env
#
# .env is gitignored and loaded automatically by the Makefile, so local
# development needs no /etc/code-scout.conf.

CS_DB_HOST=127.0.0.1
CS_DB_PORT=5432
CS_DB_USER=code_scout
CS_DB_PASSWORD=code_scout
CS_DB_NAME=code_scout
CS_DB_SSLMODE=disable

CS_HOST=localhost
CS_PORT=24275
